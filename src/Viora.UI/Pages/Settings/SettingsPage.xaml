<UserControl
    x:Class="Viora.UI.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:pages="clr-namespace:Viora.UI.Pages"
    xmlns:controls="clr-namespace:Viora.UI.Controls">
    <pages:PageChrome TitleKey="Settings.Title" SubtitleKey="Settings.Subtitle">
        <!-- Category column is pinned to the far left; the detail column centers its own content. -->
        <Grid HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                     Background="Transparent" BorderThickness="0" VerticalContentAlignment="Top">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="8,0">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Height="34" Margin="0,1">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.SurfaceElevated}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left">
                    <!-- General -->
                    <StackPanel Visibility="{Binding IsCategoryGeneral, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.General}" Margin="0,0,0,12" />
                        <controls:FormCheckBox IsChecked="{Binding StartMaximized}"
                                  Label="{loc:Translate Settings.General.StartMaximized}" Description="{loc:Translate Settings.General.StartMaximized.Description}" />
                        <controls:FormCheckBox IsChecked="{Binding ConfirmClose}"
                                  Label="{loc:Translate Settings.General.ConfirmClose}" Description="{loc:Translate Settings.General.ConfirmClose.Description}" />
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel Visibility="{Binding IsCategoryAppearance, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Appearance}" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Translate Settings.Appearance.Theme}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" />
                        <ItemsControl ItemsSource="{Binding ThemeCards}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="120" Margin="0,0,10,10">
                                        <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Card" Background="{DynamicResource Color.SurfaceElevated}"
                                                            BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1"
                                                            CornerRadius="{DynamicResource Radius.Medium}" Padding="10">
                                                        <StackPanel>
                                                            <Border Height="34" CornerRadius="6" ClipToBounds="True">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Rectangle Grid.Column="0" Fill="{Binding PreviewBackgroundBrush}" />
                                                                    <Rectangle Grid.Column="1" Fill="{Binding PreviewSurfaceBrush}" />
                                                                    <Rectangle Grid.Column="2" Fill="{Binding PreviewAccentBrush}" />
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding LocalName}" FontSize="11.5" Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource Color.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <!-- Edit / delete overlay (user schemes only) -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                                                    Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    Command="{Binding DataContext.EditThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Translate Theme.Edit}">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                                    Command="{Binding DataContext.DeleteThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" ToolTip="{loc:Translate Theme.Delete}">
                                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- New custom theme -->
                        <Button Command="{Binding NewThemeCommand}" Cursor="Hand" HorizontalAlignment="Left">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NewCard" Width="120" Background="Transparent"
                                            BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Medium}" Padding="10">
                                        <StackPanel>
                                            <Border Height="34" CornerRadius="6" Background="{DynamicResource Color.SurfaceHigh}">
                                                <TextBlock Text="+" FontSize="20" Foreground="{DynamicResource Color.Text.Secondary}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{loc:Translate Theme.New}" FontSize="11.5" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="NewCard" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Custom theme editor -->
                        <Border Background="{DynamicResource Color.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Large}"
                                Padding="18" Margin="0,10,0,8"
                                Visibility="{Binding EditingThemeVisible, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="14" Text="{loc:Translate Theme.EditorTitle}" />
                                    <Button Grid.Column="1" Style="{DynamicResource DangerButton}" Content="{loc:Translate Theme.Delete}"
                                            Command="{Binding DeleteEditingThemeCommand}"
                                            Visibility="{Binding EditingIsExisting, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>

                                <TextBlock Text="{loc:Translate Theme.Name}" FontSize="12" Margin="0,12,0,4" Foreground="{DynamicResource Color.Text.Primary}" />
                                <TextBox Style="{DynamicResource VioraTextBox}" Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding EditColorRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                                                <TextBox Grid.Column="1" Style="{DynamicResource VioraTextBox}" Margin="0,0,8,0"
                                                         Text="{Binding HexValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                                <Rectangle Grid.Column="2" Height="24" RadiusX="4" RadiusY="4"
                                                           Fill="{Binding Brush}" Stroke="{DynamicResource Color.Outline}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{DynamicResource VioraButton}" Content="{loc:Translate Theme.Save}"
                                            Command="{Binding SaveThemeCommand}" Margin="0,0,10,0" />
                                    <Button Style="{DynamicResource SecondaryButton}" Content="{loc:Translate Theme.Cancel}"
                                            Command="{Binding CancelEditThemeCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{loc:Translate Settings.Appearance.Theme.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" Margin="0,4,0,0" />
                        <TextBlock Text="{loc:Translate Settings.Appearance.UiScale}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="0.8" Maximum="1.4" Value="{Binding UiScale}" Width="240" HorizontalAlignment="Left" Margin="0,6,0,4" IsSnapToTickEnabled="True" TickFrequency="0.05" />
                        <TextBlock Text="{loc:Translate Settings.Appearance.UiScale.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                    </StackPanel>

                    <!-- Language -->
                    <StackPanel Visibility="{Binding IsCategoryLanguage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Language}" Margin="0,0,0,12" />
                        <ComboBox Style="{DynamicResource VioraCombo}" SelectedValue="{Binding Language}" ItemsSource="{Binding AvailableLanguages}" Width="180" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="{loc:Translate Settings.Language.Language.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                    </StackPanel>

                    <!-- Image processing -->
                    <StackPanel Visibility="{Binding IsCategoryProcessing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.ImageProcessing}" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Translate Settings.Processing.PreviewMaxDimension}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="512" Maximum="2048" Value="{Binding PreviewMaxDimension}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="128" Margin="0,6,0,2" />
                        <TextBlock Text="{loc:Translate Settings.Processing.PreviewMaxDimension.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                        <TextBlock Text="{loc:Translate Settings.Processing.ExportMaxDimension}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="1024" Maximum="8192" Value="{Binding ExportMaxDimension}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="512" Margin="0,6,0,2" />
                        <TextBlock Text="{loc:Translate Settings.Processing.ExportMaxDimension.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                        <TextBlock Text="{loc:Translate Settings.Processing.PaletteSize}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="4" Maximum="16" Value="{Binding PaletteSize}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,2" />
                        <TextBlock Text="{loc:Translate Settings.Processing.PaletteSize.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                    </StackPanel>

                    <!-- Export -->
                    <StackPanel Visibility="{Binding IsCategoryExport, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Export}" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Translate Settings.Export.DefaultFormat}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" />
                        <ComboBox Style="{DynamicResource VioraCombo}" SelectedValue="{Binding DefaultFormat}" ItemsSource="{Binding FormatOptions}" Width="180" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Translate Settings.Export.JpegQuality}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="50" Maximum="100" Value="{Binding JpegQuality}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Plugins -->
                    <StackPanel Visibility="{Binding IsCategoryPlugins, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Plugins}" Margin="0,0,0,12" />
                        <controls:FormCheckBox IsChecked="{Binding EnablePluginLoading}"
                                  Label="{loc:Translate Settings.Plugins.EnableLoading}" Description="{loc:Translate Settings.Plugins.EnableLoading.Description}" />
                    </StackPanel>

                    <!-- Performance -->
                    <StackPanel Visibility="{Binding IsCategoryPerformance, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Performance}" Margin="0,0,0,12" />
                        <TextBlock Text="{loc:Translate Settings.Performance.MaxParallelism}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="0" Maximum="16" Value="{Binding MaxParallelism}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,6,0,2" />
                        <TextBlock Text="{loc:Translate Settings.Performance.MaxParallelism.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                        <controls:FormCheckBox IsChecked="{Binding PreviewDuringInteraction}"
                                  Label="{loc:Translate Settings.Performance.PreviewDuringInteraction}" Description="{loc:Translate Settings.Performance.PreviewDuringInteraction.Description}" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Cache -->
                    <StackPanel Visibility="{Binding IsCategoryCache, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Cache}" Margin="0,0,0,12" />
                        <controls:FormCheckBox IsChecked="{Binding EnableCache}"
                                  Label="{loc:Translate Settings.Cache.Enable}" Description="{loc:Translate Settings.Cache.Enable.Description}" />
                        <TextBlock Text="{loc:Translate Settings.Cache.MaxSize}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <Slider Style="{DynamicResource VioraSlider}" Minimum="64" Maximum="4096" Value="{Binding MaxCacheSizeMb}" Width="240" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="64" Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Privacy -->
                    <StackPanel Visibility="{Binding IsCategoryPrivacy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Privacy}" Margin="0,0,0,12" />
                        <controls:FormCheckBox IsChecked="{Binding ShareUsage}"
                                  Label="{loc:Translate Settings.Privacy.ShareUsage}" Description="{loc:Translate Settings.Privacy.ShareUsage.Description}" />
                        <controls:FormCheckBox IsChecked="{Binding RedactPaths}"
                                  Label="{loc:Translate Settings.Privacy.RedactPaths}" Description="{loc:Translate Settings.Privacy.RedactPaths.Description}" />
                    </StackPanel>

                    <!-- Developer -->
                    <StackPanel Visibility="{Binding IsCategoryDeveloper, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{loc:Translate Settings.Group.Developer}" Margin="0,0,0,12" />
                        <controls:FormCheckBox IsChecked="{Binding DeveloperMode}"
                                  Label="{loc:Translate Settings.Debug.DeveloperMode}" Description="{loc:Translate Settings.Debug.DeveloperMode.Description}" />
                        <TextBlock Text="{loc:Translate Settings.Debug.LogLevel}" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" Margin="0,16,0,0" />
                        <ComboBox Style="{DynamicResource VioraCombo}" SelectedValue="{Binding LogLevel}" ItemsSource="{Binding LogLevelOptions}" Width="180" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        <TextBlock Text="{loc:Translate Settings.Debug.LogLevel.Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                    </StackPanel>

                    <TextBlock Text="{loc:Translate Settings.RestartNote}" FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" Margin="0,16,0,0" />

                    <!-- Save bar -->
                    <Border Background="{DynamicResource Color.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Medium}"
                            Padding="14,10" Margin="0,18,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Translate Settings.SaveHint}" FontSize="12"
                                       Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <Button Grid.Column="1" Style="{DynamicResource VioraButton}" Content="{loc:Translate Settings.SaveAndApply}"
                                    Command="{Binding SaveAndApplyCommand}" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Saved toast -->
            <Border x:Name="SavedToast" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="{DynamicResource Color.PrimaryContainer}" CornerRadius="17"
                    Padding="18,8" Margin="0,0,0,8"
                    Visibility="{Binding SavedToastVisible, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{loc:Translate Settings.SavedToast}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource Color.OnPrimaryContainer}" />
            </Border>
        </Grid>
    </pages:PageChrome>
</UserControl>
