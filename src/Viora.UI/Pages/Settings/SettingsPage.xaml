<UserControl
    x:Class="Viora.UI.Pages.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:pages="clr-namespace:Viora.UI.Pages.Settings">
    <UserControl.Resources>
        <!-- 设置子导航容器:胶囊选中态 -->
        <Style x:Key="SettingsNavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="11" Padding="12,9" Margin="0,2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.GlassStrong}" />
                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                <Setter TargetName="Row" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Row" Property="Effect" Value="{DynamicResource Shadow.PrimaryGlow}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 设置分组卡片 -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左:设置子导航 ==================== -->
        <Border Grid.Column="0" CornerRadius="14" Padding="14,16" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,12">
                    <controls:VioraIcon Geometry="{StaticResource Icon.Gear}" Width="17" Height="17"
                                        Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate Settings.Title}" FontSize="17" FontWeight="Bold" Margin="9,0,0,0"
                               Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                </StackPanel>
                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0"
                         ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}"
                         ItemContainerStyle="{StaticResource SettingsNavItem}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}" Width="15" Height="15"
                                                    Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Margin="0,1,0,0"
                                               Foreground="{DynamicResource Color.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ==================== 中:设置内容 ==================== -->
        <Border Grid.Column="2" CornerRadius="14" Padding="22,18" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 头 -->
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,4">
                        <controls:VioraIcon Geometry="{Binding SelectedSection.IconKey, Converter={StaticResource IconKey}}" Width="16" Height="16"
                                            Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedSection.Title}" FontSize="17" FontWeight="Bold" Margin="9,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Brush.Glass}" CornerRadius="8" Padding="8,2" Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding SelectedSection.IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Text="{loc:Translate Settings.ComingSoon}" FontSize="10"
                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Subtitle}" FontSize="11.5" Margin="2,4,0,14"
                               Foreground="{DynamicResource Color.Text.Secondary}" />

                    <!-- ======== 通用设置 ======== -->
                    <StackPanel Visibility="{Binding IsGeneralSelected, Converter={StaticResource BoolToVisibility}}">
                        <!-- 启动行为 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Startup}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.General.StartMaximized}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.General.StartMaximized.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding StartMaximized}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 语言 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Language}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.General.Language}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.General.Language.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource VioraCombo}" Width="170" Height="34"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding LanguageItems}"
                                              SelectedValue="{Binding SelectedLanguage}"
                                              SelectedValuePath="Code">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 隐私 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Privacy}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Privacy.Redact}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Privacy.Redact.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding RedactPathsInLogs}" />
                                        <TextBlock Text="{Binding RedactStateText}" FontSize="10" Margin="0,5,2,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 调试 -->
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Debug}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Debug.LogLevel}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Debug.LogLevel.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource VioraCombo}" Width="150" Height="34"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding LogLevels}"
                                              SelectedItem="{Binding SelectedLogLevel}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Debug.DevMode}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Debug.DevMode.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding DeveloperMode}" />
                                </Grid>
                                <Separator Margin="0,12,0,12" Background="{DynamicResource Color.Divider}" />
                                <TextBlock Text="{loc:Translate Settings.Debug.LogFolder}" FontSize="13"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <TextBlock Text="{loc:Translate Settings.Debug.LogFolder.Desc}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource Color.SurfaceElevated}" CornerRadius="8" Padding="10,7"
                                            BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding LogFolderDisplay}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{DynamicResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Command="{Binding ChooseLogFolderCommand}"
                                                Content="{loc:Translate Settings.Storage.Choose}" />
                                        <Button Style="{DynamicResource SecondaryButton}" Height="32" Padding="12,0" Margin="0,0,8,0"
                                                Command="{Binding OpenLogFolderCommand}"
                                                Content="{loc:Translate Settings.Storage.Open}" />
                                        <Button Style="{DynamicResource SecondaryButton}" Height="32" Padding="12,0"
                                                Command="{Binding ResetLogFolderCommand}"
                                                Content="{loc:Translate Settings.Storage.Reset}"
                                                Visibility="{Binding LogFolderIsCustom, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======== 外观主题 ======== -->
                    <StackPanel Visibility="{Binding IsAppearanceSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{loc:Translate Settings.Appearance.Pick}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                    <Button Style="{DynamicResource SecondaryButton}" Height="30" Padding="14,0" HorizontalAlignment="Right"
                                            Command="{Binding StartNewThemeCommand}"
                                            Content="{loc:Translate Settings.Theme.New}" />
                                </Grid>
                                <Separator Margin="0,10,0,14" Background="{DynamicResource Color.Divider}" />
                                <ItemsControl ItemsSource="{Binding ThemeCards}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="0,0,12,12" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                    Command="{Binding DataContext.ApplyThemeCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Card" Width="128" CornerRadius="12" Padding="8"
                                                                Background="{DynamicResource Color.SurfaceElevated}"
                                                                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1.4">
                                                            <StackPanel>
                                                                <Border Height="52" CornerRadius="8" Background="{Binding PreviewBackgroundBrush}">
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                Orientation="Horizontal">
                                                                        <Border Width="16" Height="16" CornerRadius="8" Background="{Binding PreviewAccentBrush}" />
                                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{Binding PreviewSurfaceBrush}"
                                                                                BorderBrush="{Binding PreviewTextPrimaryBrush}" BorderThickness="1" Margin="6,0,0,0" />
                                                                        <Border Width="16" Height="16" CornerRadius="4" Background="{Binding PreviewPrimaryContainerBrush}"
                                                                                Margin="6,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Grid Margin="0,7,0,0">
                                                                    <TextBlock Text="{Binding LocalName}" FontSize="11.5" HorizontalAlignment="Center"
                                                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource IconButton}"
                                                                            Width="18" Height="18" Margin="0,-2,-2,0"
                                                                            Command="{Binding DataContext.DeleteThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{loc:Translate Theme.Delete}"
                                                                            Visibility="{Binding IsUser, Converter={StaticResource BoolToVisibility}}">
                                                                        <controls:VioraIcon Geometry="{StaticResource Icon.Xmark}" Width="8" Height="8"
                                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                                <Setter TargetName="Card" Property="Effect" Value="{DynamicResource Shadow.PrimaryGlow}" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Translate Settings.Appearance.Note}" FontSize="10.5" Margin="2,2,0,0"
                                           Foreground="{DynamicResource Color.Text.Secondary}" />
                            </StackPanel>
                        </Border>

                        <!-- 自定义主题编辑器 -->
                        <Border Style="{StaticResource SettingsCard}"
                                Visibility="{Binding IsThemeEditorOpen, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Theme.EditorTitle}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{loc:Translate Settings.Theme.NameLabel}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                    <TextBox Grid.Column="1" Style="{DynamicResource VioraTextBox}" Height="32" Margin="14,0,0,0"
                                             Text="{Binding EditorName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding EditorColorRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="26" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Color.Text.Secondary}" />
                                                <Border Grid.Column="1" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                                        Background="{Binding Brush}" BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1" />
                                                <TextBox Grid.Column="2" Style="{DynamicResource VioraTextBox}" Height="28" Margin="10,0,0,0"
                                                         Text="{Binding HexValue, UpdateSourceTrigger=LostFocus}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                                    <Button Style="{DynamicResource SecondaryButton}" Height="34" Padding="16,0" Margin="0,0,10,0"
                                            Command="{Binding CancelThemeEditorCommand}"
                                            Content="{loc:Translate Settings.Theme.CancelTheme}" />
                                    <Button Height="34" Padding="18,0" Command="{Binding SaveThemeCommand}"
                                            Content="{loc:Translate Settings.Theme.Save}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======== 性能设置 ======== -->
                    <StackPanel Visibility="{Binding IsPerformanceSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Quality}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Perf.PreviewQuality}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Perf.PreviewQuality.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding UsePreviewQualityDuringInteraction}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Dimensions}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Perf.PreviewMax}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Perf.PreviewMax.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{DynamicResource VioraTextBox}" Width="110" Height="34"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             Text="{Binding PreviewMaxDimension, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Perf.ExportMax}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Perf.ExportMax.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBox Grid.Column="1" Style="{DynamicResource VioraTextBox}" Width="110" Height="34"
                                             VerticalAlignment="Center" TextAlignment="Center"
                                             Text="{Binding ExportMaxDimension, UpdateSourceTrigger=LostFocus}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Group.Export}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Perf.ExportFormat}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Perf.ExportFormat.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" Style="{DynamicResource VioraCombo}" Width="130" Height="34"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding ExportFormats}"
                                              SelectedItem="{Binding SelectedExportFormat}" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Perf.JpegQuality}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Perf.JpegQuality.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Slider Width="150" Minimum="1" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                                Value="{Binding JpegQuality}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding JpegQuality, StringFormat={}{0}%}" FontSize="12" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Color.Text.Primary}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======== 插件管理 ======== -->
                    <StackPanel Visibility="{Binding IsPluginsSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Plugins.Enable}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{loc:Translate Settings.Plugins.Enable}" FontSize="13"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{loc:Translate Settings.Plugins.Enable.Desc}" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource SettingsSwitch}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding EnablePluginLoading}" />
                                        <TextBlock Text="{Binding EnablePluginNote}" FontSize="10" Margin="0,5,2,0"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="{loc:Translate Settings.Plugins.Installed}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                                <TextBlock Text="{loc:Translate Settings.Plugins.Empty}" FontSize="12" Margin="2,4"
                                           Foreground="{DynamicResource Color.Text.Secondary}"
                                           Visibility="{Binding HasPluginRows, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding PluginRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Version}" FontSize="10.5"
                                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                                        <TextBlock Text="{Binding StateText}" FontSize="10.5" Margin="10,0,0,0"
                                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <ToggleButton Grid.Column="1" Style="{StaticResource SettingsSwitch}" VerticalAlignment="Center"
                                                              IsChecked="{Binding IsEnabled}" Command="{Binding ToggleCommand}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Translate Settings.Plugins.MarketHint}" FontSize="10.5" Margin="2,10,0,0"
                                           Foreground="{DynamicResource Color.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======== 关于 ======== -->
                    <StackPanel Visibility="{Binding IsAboutSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <TextBlock Text="Viora" FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                <TextBlock Text="{loc:Translate App.Tagline}" FontSize="11.5" Margin="1,4,0,0"
                                           Foreground="{DynamicResource Color.Text.Secondary}" />
                                <Separator Margin="0,12,0,12" Background="{DynamicResource Color.Divider}" />
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="{loc:Translate Settings.About.Version}" FontSize="12"
                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                    <TextBlock Text="{Binding AppVersion}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                </Grid>
                                <Grid>
                                    <TextBlock Text="{loc:Translate Settings.About.Repo}" FontSize="12"
                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Text="{x:Static pages:SettingsViewModel.RepoUrl}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Color.Primary}" />
                                        <Button Style="{DynamicResource IconButton}" Width="28" Height="28" Margin="8,0,0,0"
                                                Command="{Binding OpenRepoCommand}"
                                                ToolTip="{loc:Translate Settings.About.OpenRepo}">
                                            <controls:VioraIcon Geometry="{StaticResource Icon.Expand}" Width="12" Height="12"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ==================== 右:辅助卡 ==================== -->
        <StackPanel Grid.Column="4">
            <!-- 存储与空间 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.FolderOpen}" Width="14" Height="14"
                                            Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Settings.Storage.Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Separator Margin="0,10,0,12" Background="{DynamicResource Color.Divider}" />
                    <TextBlock Text="{loc:Translate Settings.Storage.Works}" FontSize="11"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Grid Margin="0,5,0,12">
                        <TextBlock Text="{Binding WorksFolderDisplay}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                    Command="{Binding ChooseWorksFolderCommand}" ToolTip="{loc:Translate Settings.Storage.Choose}">
                                <controls:VioraIcon Geometry="{StaticResource Icon.PenToSquare}" Width="11" Height="11"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Style="{DynamicResource IconButton}" Width="26" Height="26"
                                    Command="{Binding OpenWorksFolderCommand}" ToolTip="{loc:Translate Settings.Storage.Open}">
                                <controls:VioraIcon Geometry="{StaticResource Icon.FolderOpen}" Width="11" Height="11"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{loc:Translate Settings.Storage.LogsLabel}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Grid Margin="0,5,0,12">
                        <TextBlock Text="{Binding LogFolderDisplay}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                        <Button Style="{DynamicResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right"
                                Command="{Binding OpenLogFolderCommand}" ToolTip="{loc:Translate Settings.Storage.Open}">
                            <controls:VioraIcon Geometry="{StaticResource Icon.FolderOpen}" Width="11" Height="11"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                    <TextBlock Text="{loc:Translate Settings.Storage.Plugins}" FontSize="11"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Grid Margin="0,5,0,0">
                        <TextBlock Text="{Binding PluginsFolder}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                        <Button Style="{DynamicResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right"
                                Command="{Binding OpenPluginsFolderCommand}" ToolTip="{loc:Translate Settings.Storage.Open}">
                            <controls:VioraIcon Geometry="{StaticResource Icon.FolderOpen}" Width="11" Height="11"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 重置设置 -->
            <Border Style="{StaticResource SettingsCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.ArrowRotateLeft}" Width="14" Height="14"
                                            Foreground="{DynamicResource Color.Danger}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Settings.Reset.Title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate Settings.Reset.Desc}" FontSize="11" Margin="1,10,0,0"
                               Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />
                    <TextBlock Text="{loc:Translate Settings.Reset.LanguageNote}" FontSize="10.5" Margin="1,6,0,0"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Button Style="{DynamicResource SecondaryButton}" Height="36" Margin="0,14,0,0" HorizontalAlignment="Right"
                            Command="{Binding ResetToDefaultsCommand}"
                            Content="{loc:Translate Settings.Reset.Button}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
