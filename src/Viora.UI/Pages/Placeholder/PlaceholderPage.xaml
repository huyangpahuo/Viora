<UserControl
    x:Class="Viora.UI.Pages.Placeholder.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:loc="clr-namespace:Viora.UI.Localization">

    <!--
        占位页:重构期间除“风格化”外的导航目标统一落在这里(空白处理)。
        标题由 ShellViewModel 按当前导航项注入(TitleKey/SubtitleKey)。
    -->
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
            <Border Width="88" Height="88" CornerRadius="26" HorizontalAlignment="Center"
                    Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Color.Border}"
                    BorderThickness="1" ClipToBounds="True">
                <Image Source="pack://application:,,,/Viora.UI;component/logo.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0"
                       Foreground="{DynamicResource Color.Text.Primary}" />
            <TextBlock x:Name="SubtitleText" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Color.Text.Secondary}" />
            <TextBlock Text="{loc:Translate Placeholder.ComingSoon}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,18,0,0"
                       Foreground="{DynamicResource Color.Text.Disabled}" />
        </StackPanel>
    </Grid>
</UserControl>
