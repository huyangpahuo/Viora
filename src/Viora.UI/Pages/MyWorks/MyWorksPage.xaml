<UserControl
    x:Class="Viora.UI.Pages.MyWorks.MyWorksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:loc="clr-namespace:Viora.UI.Localization">

    <!--
        我的作品:作品管理中心(作品 ≠ 文件)。
        左 = 标题 + 筛选 Tab + 搜索/排序 + 作品卡片网格;
        右 = 当前作品 Inspector(大预览、信息、参数快照、操作)。
        卡片快捷操作:收藏 / 导出 / 更多(副本、重新生成、打开所在文件夹、删除)。
    -->

    <UserControl.Resources>
        <!-- 风格胶囊标签 -->
        <Style x:Key="StyleTagPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Color.PrimaryContainer}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,2.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 列表行容器 -->
        <Style x:Key="WorkRowItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 作品卡片 -->
        <Style x:Key="WorkCardItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 详情区信息行 -->
        <Style x:Key="InfoRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>

        <!-- 搜索输入(无边框,占位用 Tag) -->
        <Style x:Key="WorksSearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Color.Primary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,8" />
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="12.5" FontFamily="{DynamicResource Font.Family}"
                                       Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringEmptyToVisibility}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 详情标题(可编辑,无边框) -->
        <Style x:Key="WorksTitleBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Color.Primary}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="2,2">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Glass}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 作品库 ==================== -->
        <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="14" Padding="16,14"
                Background="{DynamicResource Color.Surface}" BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 头部:标题 + 搜索 + 排序 + 视图 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Nav.MyWorks}" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- 搜索 -->
                        <Border Width="252" Background="{DynamicResource Color.SurfaceElevated}" CornerRadius="10"
                                BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1" Padding="10,0,8,0" Height="34">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:VioraIcon Geometry="{StaticResource Icon.MagnifyingGlass}" Width="13" Height="13"
                                                    Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Style="{DynamicResource WorksSearchBox}" Grid.ColumnSpan="2" Margin="20,0,0,0"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{loc:Translate Works.Search.Placeholder}" />
                            </Grid>
                        </Border>

                        <!-- 排序 -->
                        <ComboBox Style="{DynamicResource VioraCombo}" Width="142" Height="34" Margin="8,0,0,0"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortKey}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource TranslateKey}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- 视图切换:网格 ⇄ 列表 -->
                        <Button Style="{DynamicResource IconButton}" Width="34" Height="34" Margin="6,0,0,0"
                                Command="{Binding ToggleViewCommand}" ToolTip="{Binding ViewToggleTooltip}">
                            <Grid>
                                <controls:VioraIcon Geometry="{StaticResource Icon.List}" Width="15" Height="15"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Visibility="{Binding IsListView, Converter={StaticResource InverseBoolToVisibility}}" />
                                <controls:VioraIcon Geometry="{StaticResource Icon.TableCells}" Width="15" Height="15"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 筛选 Tab -->
                <ListBox Grid.Row="1" Margin="0,0,0,4" BorderThickness="0" Background="Transparent" Padding="0"
                         ItemsSource="{Binding TabFilters}" SelectedItem="{Binding TabFilter}"
                         ItemContainerStyle="{StaticResource ChipPillItem}"
                         PreviewMouseWheel="OnChipsWheel"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource TranslateKey}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 卡片网格 / 空状态(分页) -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="WorksScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnListWheel">
                    <StackPanel>
                        <ListBox BorderThickness="0" Background="Transparent" Margin="-6,4,-6,0"
                                 Visibility="{Binding IsListView, Converter={StaticResource InverseBoolToVisibility}}"
                                 ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 ItemContainerStyle="{StaticResource WorkCardItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Width="206" Margin="6,6" CornerRadius="13" Padding="8"
                                            Background="{DynamicResource Color.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1.4">
                                        <StackPanel>
                                            <!-- 结果图(统一比例,圆角) -->
                                            <Border Height="134" CornerRadius="9" Background="{Binding Thumbnail, Converter={StaticResource ImageToBrush}}">
                                                <Border x:Name="CheckBadge" Width="20" Height="20" CornerRadius="10"
                                                        Background="{DynamicResource Color.Primary}" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="0,7,7,0" Visibility="Collapsed"
                                                        Effect="{DynamicResource Shadow.Card}">
                                                    <controls:VioraIcon Geometry="{StaticResource Icon.Check}" Width="10" Height="10" Foreground="White" />
                                                </Border>
                                            </Border>

                                            <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Margin="5,9,5,0"
                                                       Foreground="{DynamicResource Color.Text.Primary}" TextTrimming="CharacterEllipsis" />

                                            <StackPanel Orientation="Horizontal" Margin="5,7,5,0">
                                                <Border Style="{StaticResource StyleTagPill}">
                                                    <TextBlock Text="{Binding StyleName}" FontSize="10.5" Foreground="{DynamicResource Color.OnPrimaryContainer}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding TimeDisplay}" FontSize="11" Margin="5,7,5,0"
                                                       Foreground="{DynamicResource Color.Text.Secondary}" />

                                            <!-- 快捷操作:收藏 | 导出 更多 -->
                                            <Grid Margin="2,8,2,2">
                                                <Button Style="{DynamicResource IconButton}" Width="28" Height="28"
                                                        HorizontalAlignment="Left" Command="{Binding ToggleFavoriteCommand}"
                                                        ToolTip="{Binding FavoriteTooltip}">
                                                    <controls:VioraIcon x:Name="StarIcon" Geometry="{StaticResource Icon.Star}" Width="14" Height="14">
                                                        <!-- Foreground 必须由样式持有:元素本地值优先级高于触发器,写了本地值星标永远不变金 -->
                                                        <controls:VioraIcon.Style>
                                                            <Style TargetType="controls:VioraIcon" BasedOn="{StaticResource {x:Type controls:VioraIcon}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:VioraIcon.Style>
                                                    </controls:VioraIcon>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Style="{DynamicResource IconButton}" Width="28" Height="28"
                                                            Command="{Binding ExportCommand}" ToolTip="{loc:Translate Works.Card.Export}">
                                                        <controls:VioraIcon Geometry="{StaticResource Icon.Download}" Width="14" Height="14"
                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                    <Button Style="{DynamicResource IconButton}" Width="28" Height="28"
                                                            Click="OnMoreClick" ToolTip="{loc:Translate Works.Card.More}">
                                                        <controls:VioraIcon Geometry="{StaticResource Icon.Ellipsis}" Width="14" Height="14"
                                                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            <Setter TargetName="Card" Property="Effect" Value="{DynamicResource Shadow.PrimaryGlow}" />
                                            <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="StarIcon" Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            </ListBox>

                        <!-- 列表视图 -->
                        <ListBox BorderThickness="0" Background="Transparent" Margin="0,4,0,0"
                                 Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibility}}"
                                 ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 ItemContainerStyle="{StaticResource WorkRowItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Row" CornerRadius="11" Padding="10,7" Margin="0,2"
                                            Background="Transparent" BorderBrush="Transparent" BorderThickness="1.2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="86" Height="56" CornerRadius="8"
                                                    Background="{Binding Thumbnail, Converter={StaticResource ImageToBrush}}" />

                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Color.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Style="{StaticResource StyleTagPill}">
                                                        <TextBlock Text="{Binding StyleName}" FontSize="10" Foreground="{DynamicResource Color.OnPrimaryContainer}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding TimeDisplay}" FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0"
                                                       Foreground="{DynamicResource Color.Text.Secondary}" />

                                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{DynamicResource IconButton}" Width="30" Height="30"
                                                        Command="{Binding ToggleFavoriteCommand}" ToolTip="{Binding FavoriteTooltip}">
                                                    <controls:VioraIcon x:Name="RowStar" Geometry="{StaticResource Icon.Star}" Width="14" Height="14">
                                                        <controls:VioraIcon.Style>
                                                            <Style TargetType="controls:VioraIcon" BasedOn="{StaticResource {x:Type controls:VioraIcon}}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </controls:VioraIcon.Style>
                                                    </controls:VioraIcon>
                                                </Button>
                                                <Button Style="{DynamicResource IconButton}" Width="30" Height="30"
                                                        Command="{Binding ExportCommand}" ToolTip="{loc:Translate Works.Card.Export}">
                                                    <controls:VioraIcon Geometry="{StaticResource Icon.Download}" Width="14" Height="14"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                                <Button Style="{DynamicResource IconButton}" Width="30" Height="30"
                                                        Click="OnMoreClick" ToolTip="{loc:Translate Works.Card.More}">
                                                    <controls:VioraIcon Geometry="{StaticResource Icon.Ellipsis}" Width="14" Height="14"
                                                                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Glass}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter TargetName="RowStar" Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                    </ScrollViewer>
                    <controls:Pager Grid.Row="1" Margin="0,8,0,0" PageSize="16"
                                    TotalItems="{Binding WorksTotalItems}" CurrentPage="{Binding WorksPage, Mode=TwoWay}"
                                    Visibility="{Binding WorksPagerVisible, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 空状态 -->
                    <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasWorks, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="76" Height="76" CornerRadius="22" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1">
                            <controls:VioraIcon Geometry="{StaticResource Icon.Images}" Width="30" Height="30"
                                                Foreground="{DynamicResource Color.Primary}" />
                        </Border>
                        <TextBlock Text="{loc:Translate Works.Empty.Title}" FontSize="15" FontWeight="SemiBold" Margin="0,16,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Works.Empty.Subtitle}" FontSize="12" Margin="0,7,0,0"
                                   Foreground="{DynamicResource Color.Text.Secondary}" HorizontalAlignment="Center" />
                        <Button Style="{DynamicResource SecondaryButton}" Command="{Binding GoStylizeCommand}" Margin="0,14,0,0"
                                Content="{loc:Translate Works.Empty.Cta}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 当前作品详情 ==================== -->
        <Border Grid.Column="1" CornerRadius="14" Padding="16,14" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <!-- 大预览 -->
                    <Border Height="224" CornerRadius="12" Background="{Binding SelectedCard.Thumbnail, Converter={StaticResource ImageToBrush}}">
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="9" Padding="10,3"
                                Background="{DynamicResource Brush.BrandSoft}">
                            <TextBlock Text="{loc:Translate Works.Detail.Stylized}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Border>

                    <!-- 名称(可编辑)+ 标签 -->
                    <TextBox x:Name="TitleBox" Style="{DynamicResource WorksTitleBox}" Margin="0,13,0,0"
                             Text="{Binding SelectedCard.Record.Title, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="OnTitleCommit" KeyDown="OnTitleEnter" />

                    <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                        <Border Style="{StaticResource StyleTagPill}">
                            <TextBlock Text="{Binding SelectedCard.StyleName}" FontSize="11" Foreground="{DynamicResource Color.OnPrimaryContainer}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.Glass}" CornerRadius="8" Padding="9,2.5" Margin="7,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Translate Works.Detail.Stylized}" FontSize="11" Foreground="{DynamicResource Color.Text.Secondary}" />
                        </Border>
                    </StackPanel>

                    <!-- 时间 + 收藏 + 更多 -->
                    <Grid Margin="2,12,0,0">
                        <TextBlock Text="{Binding SelectedCard.TimeDisplay}" FontSize="11.5" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource IconButton}" Width="30" Height="30"
                                    Command="{Binding SelectedCard.ToggleFavoriteCommand}"
                                    ToolTip="{Binding SelectedCard.FavoriteTooltip}">
                                <controls:VioraIcon Geometry="{StaticResource Icon.Star}" Width="15" Height="15">
                                    <!-- Foreground 由样式持有(本地值会压过触发器);必须 BasedOn 隐式样式,否则模板被覆盖图标不渲染 -->
                                    <controls:VioraIcon.Style>
                                        <Style TargetType="controls:VioraIcon" BasedOn="{StaticResource {x:Type controls:VioraIcon}}">
                                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedCard.IsFavorite}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Color.Warning}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:VioraIcon.Style>
                                </controls:VioraIcon>
                            </Button>
                            <Button Style="{DynamicResource IconButton}" Width="30" Height="30" Margin="2,0,0,0"
                                    Click="OnMoreClick"
                                    ToolTip="{loc:Translate Works.Card.More}">
                                <controls:VioraIcon Geometry="{StaticResource Icon.Ellipsis}" Width="15" Height="15"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,13,0,0" Background="{DynamicResource Color.Divider}" />

                    <!-- 作品信息 -->
                    <TextBlock Text="{loc:Translate Works.Info.Title}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,10"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding SelectedCard.InfoRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0,2,8">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                                    <TextBlock Text="{Binding Value}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Color.Text.Primary}" TextTrimming="CharacterEllipsis" Margin="90,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Separator Background="{DynamicResource Color.Divider}" />

                    <!-- 使用的参数(快照) -->
                    <TextBlock Text="{loc:Translate Works.Params.Title}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,10"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <ItemsControl ItemsSource="{Binding SelectedCard.DisplayParamRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,0,2,8">
                                    <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                                    <TextBlock Text="{Binding Value}" FontSize="12" HorizontalAlignment="Right"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="2,0,2,2" Visibility="{Binding SelectedCard.Record.AiQuality, Converter={StaticResource BoolToVisibility}}">
                        <controls:VioraIcon Geometry="{StaticResource Icon.Check}" Width="12" Height="12" Margin="0,1,7,0"
                                            Foreground="{DynamicResource Color.Success}" />
                        <TextBlock Text="{loc:Translate Works.Params.Ai}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                    </StackPanel>

                    <Separator Margin="0,8,0,0" Background="{DynamicResource Color.Divider}" />

                    <!-- 操作 -->
                    <TextBlock Text="{loc:Translate Works.Actions.Title}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,10"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" Command="{Binding SelectedCard.RegenerateCommand}" Height="42" FocusVisualStyle="{x:Null}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Root" Background="{DynamicResource Brush.Brand}" CornerRadius="12"
                                            Effect="{DynamicResource Shadow.BrandGlow}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <controls:VioraIcon Geometry="{StaticResource Icon.ArrowRotateLeft}" Width="13" Height="13" Foreground="White" />
                                            <TextBlock Text="{loc:Translate Works.Actions.Regenerate}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.93" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.85" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="42"
                                Command="{Binding SelectedCard.ExportCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:VioraIcon Geometry="{StaticResource Icon.Download}" Width="13" Height="13"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{loc:Translate Works.Actions.Export}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="0" Style="{DynamicResource SecondaryButton}" Height="42" Margin="0,10,0,0"
                                Command="{Binding SelectedCard.CopyCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:VioraIcon Geometry="{StaticResource Icon.Copy}" Width="13" Height="13"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{loc:Translate Works.Actions.Copy}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="42" Margin="0,10,0,0"
                                Command="{Binding SelectedCard.DeleteCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <controls:VioraIcon Geometry="{StaticResource Icon.TrashCan}" Width="13" Height="13"
                                                    Foreground="{DynamicResource Color.Danger}" />
                                <TextBlock Text="{loc:Translate Works.Actions.Delete}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
