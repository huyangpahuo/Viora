<UserControl
    x:Class="Viora.UI.Pages.Support.AboutPage"
    FontFamily="{DynamicResource Font.Family}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:controls="clr-namespace:Viora.UI.Controls">

    <!-- 关于:软件介绍 + 插件开发与上传指南 + 社区入口 -->
    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- 左:介绍 + 插件指南 -->
        <Border Grid.Column="0" CornerRadius="14" Padding="24,20" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 头部 -->
                    <StackPanel Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleInfo}" Width="22" Height="22"
                                            Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Nav.About}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Brush.Glass}" CornerRadius="8" Padding="10,3" Margin="14,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersion, StringFormat='v{0}'}" FontSize="11.5"
                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{loc:Translate App.Tagline}" FontSize="12.5" Margin="1,8,0,0"
                               Foreground="{DynamicResource Color.Text.Secondary}" />

                    <!-- 介绍 -->
                    <TextBlock Text="{loc:Translate Support.About.IntroTitle}" FontSize="14" FontWeight="SemiBold" Margin="1,22,0,0"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <TextBlock Text="{loc:Translate Support.About.Intro}" FontSize="12" Margin="1,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Color.Text.Secondary}" />

                    <!-- 插件开发指南 -->
                    <TextBlock Text="{loc:Translate Support.About.PluginTitle}" FontSize="14" FontWeight="SemiBold" Margin="1,22,0,0"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <TextBlock Text="{loc:Translate Support.About.PluginIntro}" FontSize="12" Margin="1,8,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <ItemsControl Margin="1,10,0,0" ItemsSource="{Binding PluginSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Brush.Glass}"
                                            BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1">
                                        <TextBlock Text="{Binding Index}" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Color.Primary}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text, Converter={StaticResource TranslateKey}}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{DynamicResource Color.Text.Primary}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Margin="1,14,0,0" Style="{DynamicResource SecondaryButton}" Height="34"
                            Command="{Binding OpenPluginRepoCommand}"
                            Content="{loc:Translate Support.About.OpenPluginRepo}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右:社区入口 -->
        <Border Grid.Column="2" CornerRadius="14" Padding="20,18" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{loc:Translate Support.Community.Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Color.Text.Primary}" />
                <TextBlock Text="{loc:Translate Support.Community.Sub}" FontSize="11.5" Margin="1,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Color.Text.Secondary}" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding CommunityLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,6" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" CornerRadius="10" Padding="12,10"
                                                Background="{DynamicResource Color.SurfaceElevated}"
                                                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                                    Width="14" Height="14" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Color.Secondary}" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TitleKey, Converter={StaticResource TranslateKey}}"
                                                               FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                                    <TextBlock FontSize="10.5" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Color.Text.Secondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{loc:Translate Support.Open}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                        <Setter Property="Text" Value="{loc:Translate Support.ComingSoon}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                                <controls:VioraIcon Grid.Column="2" Geometry="{StaticResource Icon.ChevronRight}"
                                                                    Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Color.Text.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>