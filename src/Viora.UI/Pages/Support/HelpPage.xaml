<UserControl
    x:Class="Viora.UI.Pages.Support.HelpPage"
    FontFamily="{DynamicResource Font.Family}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:controls="clr-namespace:Viora.UI.Controls">

    <!-- 帮助:常见问题 + 快捷入口 -->
    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- 左:FAQ -->
        <Border Grid.Column="0" CornerRadius="14" Padding="24,20" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleQuestion}" Width="20" Height="20"
                                            Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Nav.Help}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding Faqs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Margin="0,6" HorizontalAlignment="Stretch" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Card" CornerRadius="12" Padding="16,12"
                                                    Background="{DynamicResource Color.SurfaceElevated}"
                                                    BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Question, Converter={StaticResource TranslateKey}}" FontSize="13" FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                                        <controls:VioraIcon x:Name="Chevron" Geometry="{StaticResource Icon.ChevronRight}"
                                                                            Width="11" Height="11" HorizontalAlignment="Right"
                                                                            VerticalAlignment="Top" Margin="0,2,0,0"
                                                                            RenderTransformOrigin="0.5,0.5"
                                                                            Foreground="{DynamicResource Color.Text.Secondary}">
                                                            <controls:VioraIcon.RenderTransform>
                                                                <RotateTransform Angle="0" />
                                                            </controls:VioraIcon.RenderTransform>
                                                        </controls:VioraIcon>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Answer, Converter={StaticResource TranslateKey}}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Color.Text.Secondary}"
                                                               Visibility="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Chevron" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 右:快捷入口 -->
        <Border Grid.Column="2" CornerRadius="14" Padding="20,18" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{loc:Translate Support.Help.LinksTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Color.Text.Primary}" />
                <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding HelpLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,6" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" CornerRadius="10" Padding="12,10"
                                                Background="{DynamicResource Color.SurfaceElevated}"
                                                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                                        Width="14" Height="14" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Color.Secondary}" />
                                                    <TextBlock Text="{Binding TitleKey, Converter={StaticResource TranslateKey}}"
                                                               FontSize="12.5" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                                </StackPanel>
                                                <TextBlock FontSize="10.5" Margin="24,2,0,0"
                                                           Foreground="{DynamicResource Color.Text.Secondary}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding Subtitle, Converter={StaticResource TranslateKey}}" />
                                                            <Style.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
