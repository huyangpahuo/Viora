<UserControl
    x:Class="Viora.UI.Pages.Support.FeedbackPage"
    FontFamily="{DynamicResource Font.Family}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:controls="clr-namespace:Viora.UI.Controls">

    <!-- 反馈:渠道入口 + 诊断信息 -->
    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- 左:渠道 -->
        <Border Grid.Column="0" CornerRadius="14" Padding="24,20" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <controls:VioraIcon Geometry="{StaticResource Icon.Envelope}" Width="20" Height="20"
                                        Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate Nav.Feedback}" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{loc:Translate Support.Feedback.Intro}" FontSize="12" Margin="1,10,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Color.Text.Secondary}" />

                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding FeedbackLinks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,6" HorizontalContentAlignment="Stretch" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" CornerRadius="10" Padding="14,12"
                                                Background="{DynamicResource Color.SurfaceElevated}"
                                                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                                    Width="15" Height="15" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Color.Secondary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding TitleKey, Converter={StaticResource TranslateKey}}"
                                                           FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Color.Text.Primary}" />
                                                <controls:VioraIcon Geometry="{StaticResource Icon.ChevronRight}"
                                                                    Width="11" Height="11" VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource Color.Text.Disabled}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 右:诊断信息 + 日志 -->
        <StackPanel Grid.Column="2">
            <Border CornerRadius="14" Padding="20,18" Background="{DynamicResource Color.Surface}"
                    BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Support.Feedback.DiagTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <TextBlock Text="{loc:Translate Support.Feedback.DiagDesc}" FontSize="11.5" Margin="1,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Border Margin="0,12,0,0" CornerRadius="8" Padding="12,10" Background="{DynamicResource Color.SurfaceElevated}"
                            BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1">
                        <TextBlock Text="{Binding DiagnosticInfo}" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </Border>
                    <Button HorizontalAlignment="Left" Margin="0,12,0,0" Style="{DynamicResource SecondaryButton}" Height="34"
                            Command="{Binding CopyDiagnosticsCommand}"
                            Content="{loc:Translate Support.Feedback.CopyDiag}" />
                </StackPanel>
            </Border>

            <Border CornerRadius="14" Padding="20,18" Margin="0,14,0,0" Background="{DynamicResource Color.Surface}"
                    BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Translate Support.Feedback.LogsTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <TextBlock Text="{loc:Translate Support.Feedback.LogsDesc}" FontSize="11.5" Margin="1,6,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                    <Button HorizontalAlignment="Left" Margin="0,12,0,0" Style="{DynamicResource SecondaryButton}" Height="34"
                            Command="{Binding OpenLogsFolderCommand}"
                            Content="{loc:Translate Support.Feedback.OpenLogs}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
