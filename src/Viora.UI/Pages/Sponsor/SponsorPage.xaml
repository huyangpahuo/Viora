<UserControl
    x:Class="Viora.UI.Pages.Sponsor.SponsorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:pages="clr-namespace:Viora.UI.Pages">
    <pages:PageChrome TitleKey="Sponsor.Title" SubtitleKey="Sponsor.Subtitle">
        <StackPanel MaxWidth="720">
            <Border Style="{DynamicResource VioraCard}" Margin="0,8,0,12">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Typography.Body}" Text="{loc:Translate Sponsor.Body}" TextWrapping="Wrap" />
                    <Button Style="{DynamicResource VioraButton}" Content="{loc:Translate Sponsor.Button}" Command="{Binding OpenSponsorCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
            <TextBlock Style="{DynamicResource Typography.Caption}" Text="{loc:Translate Sponsor.Thanks}" />
        </StackPanel>
    </pages:PageChrome>
</UserControl>
