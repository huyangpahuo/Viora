<UserControl
    x:Class="Viora.UI.Pages.Plugins.PluginsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:pages="clr-namespace:Viora.UI.Pages">
    <pages:PageChrome TitleKey="Plugins.Title" SubtitleKey="Plugins.Subtitle">
        <StackPanel MaxWidth="820">
            <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                <Button Style="{DynamicResource VioraButton}" Content="{loc:Translate Plugins.Install}" Command="{Binding InstallCommand}" Margin="0,0,12,0" />
                <Button Style="{DynamicResource SecondaryButton}" Content="{loc:Translate Plugins.Reload}" Command="{Binding ReloadPluginsCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Plugins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource VioraCard}" Padding="20" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="15" Text="{Binding Name}" />
                                        <TextBlock Style="{DynamicResource Typography.Caption}" Text="{Binding VersionLine}" Margin="10,1,0,0" VerticalAlignment="Center" />
                                        <TextBlock Style="{DynamicResource Typography.Caption}" Text="{Binding AuthorLine}" Margin="10,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Style="{DynamicResource Typography.BodySecondary}" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Style="{DynamicResource LinkButton}" Content="{loc:Translate Plugins.Homepage}"
                                                Command="{Binding DataContext.OpenHomepageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Margin="0,0,16,0"
                                                Visibility="{Binding HasHomepage, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{DynamicResource LinkButton}" Content="{loc:Translate Plugins.Repository}"
                                                Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasRepository, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{DynamicResource Color.Danger}" VerticalAlignment="Center" />
                                        <TextBlock Style="{DynamicResource Typography.Caption}" Text="{Binding StateText}" Foreground="{DynamicResource Color.Danger}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StateText}" Style="{DynamicResource Typography.Caption}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ToggleButton Style="{DynamicResource VioraToggle}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanToggle}" VerticalAlignment="Center" />
                                    <Button Style="{DynamicResource IconButton}" Margin="12,0,0,0"
                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" ToolTip="{loc:Translate Plugins.Uninstall}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{DynamicResource Typography.BodySecondary}" Text="{loc:Translate Plugins.Empty}" Margin="0,8,0,0"
                       Visibility="{Binding HasNoPlugins, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </pages:PageChrome>
</UserControl>
