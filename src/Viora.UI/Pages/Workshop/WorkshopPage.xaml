<UserControl x:Class="Viora.UI.Pages.Workshop.WorkshopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Viora.UI.Localization"
             xmlns:controls="clr-namespace:Viora.UI.Controls"
             xmlns:avalon="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit">
    <UserControl.Resources>
        <Style x:Key="WsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="WsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="WsInput" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Color.SurfaceHigh}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Color.Primary}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Color.Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WsInputMultiline" TargetType="TextBox" BasedOn="{StaticResource WsInput}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="WsButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WsSeg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" CornerRadius="9" Padding="14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Brand}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WsOutTab" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" CornerRadius="8" Padding="10,4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Color.SurfaceElevated}" />
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WsMini" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass}" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Color.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WsLangChip" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="34" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左:源码 / 效果预览 ============ -->
        <Border Grid.Column="0" Margin="0,0,14,0" Style="{StaticResource WsCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="170" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <controls:VioraIcon Geometry="{StaticResource Icon.PenToSquare}" Width="16" Height="16"
                                        Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Translate Workshop.SourceLabel}" FontSize="15" FontWeight="Bold" Margin="8,0,10,0"
                               Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                    <Border x:Name="CompileBadge" CornerRadius="8" Padding="8,2" Background="{DynamicResource Brush.Glass}"
                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <controls:VioraIcon x:Name="BadgeIcon" Width="11" Height="11" VerticalAlignment="Center"
                                                Geometry="{StaticResource Icon.CircleCheck}"
                                                Foreground="{DynamicResource Color.Success}" />
                            <TextBlock x:Name="BadgeText" Text="OK" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabSource" Style="{StaticResource WsSeg}" GroupName="WsView"
                                     IsChecked="True" Content="{loc:Translate Workshop.TabCode}"
                                     Checked="ViewTab_OnChanged" Tag="code" />
                        <RadioButton Style="{StaticResource WsSeg}" GroupName="WsView"
                                     Content="{loc:Translate Workshop.TabPreview}" Margin="6,0,0,0"
                                     Checked="ViewTab_OnChanged" Tag="preview" />
                    </StackPanel>
                </Grid>

                <!-- ===== 源码视图:文件列表(左,可折叠) | AvalonEdit | minimap ===== -->
                <Grid Grid.Row="2" x:Name="SourceHost">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="FileListColumn" Width="150" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition x:Name="MinimapColumn" Width="56" />
                    </Grid.ColumnDefinitions>

                    <!-- 文件列表 -->
                    <Border Grid.Column="0" x:Name="FileListHost" CornerRadius="10"
                            Background="{DynamicResource Color.SurfaceElevated}"
                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="8,5" BorderBrush="{DynamicResource Color.Border}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="{loc:Translate Workshop.Files}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource WsMini}" Command="{Binding AddFileCommand}"
                                            HorizontalAlignment="Right" Content="+" ToolTip="{loc:Translate Workshop.AddFile}" />
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" x:Name="FileList" ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding ActiveFile}" Background="Transparent"
                                     BorderThickness="0" Padding="5,4,5,6"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <!-- 编辑态:重命名输入框 -->
                                            <TextBox x:Name="RenameBox" FontSize="11"
                                                     Background="{DynamicResource Color.SurfaceHigh}"
                                                     Foreground="{DynamicResource Color.Text.Primary}"
                                                     CaretBrush="{DynamicResource Color.Primary}" Padding="3,1"
                                                     Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}"
                                                     Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="RenameBox_OnKeyDown" LostFocus="RenameBox_OnLostFocus" />
                                            <!-- 常态:名字 + 重命名/删除 -->
                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}">
                                                <TextBlock Text="{Binding Name}" FontSize="11" Margin="2,2,0,2"
                                                           MouseLeftButtonDown="FileName_OnDoubleClick"
                                                           Foreground="{DynamicResource Color.Text.Secondary}"
                                                           VerticalAlignment="Center" ToolTip="{Binding Name}" />
                                                <Button Style="{StaticResource WsMini}" Width="16" Height="16" Margin="4,0,0,0"
                                                        FontSize="10" Content="✎" Click="Rename_OnClick" />
                                                <Button Style="{StaticResource WsMini}" Width="16" Height="16" Margin="2,0,0,0"
                                                        FontSize="10" Content="✕"
                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <!-- 折叠钮(列表头) + 折叠态展开钮 -->
                    <Button Grid.Column="0" Style="{StaticResource WsMini}" Command="{Binding ToggleFileListCommand}"
                            VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4,4,0,0"
                            Visibility="{Binding ShowFileList, Converter={StaticResource InverseBoolToVisibility}}"
                            Content="›" x:Name="FileListExpand" Panel.ZIndex="2" />

                    <!-- AvalonEdit 编辑器 -->
                    <Border Grid.Column="2" CornerRadius="10" BorderBrush="{DynamicResource Color.Border}" BorderThickness="1"
                            Background="{DynamicResource Color.SurfaceElevated}" ClipToBounds="True">
                        <avalon:TextEditor x:Name="Editor"
                                           PreviewMouseWheel="Editor_PreviewMouseWheel"
                                           FontFamily="Consolas" FontSize="12.5"
                                           Background="{DynamicResource Color.SurfaceElevated}"
                                           Foreground="{DynamicResource Color.Text.Primary}"
                                           WordWrap="False"
                                           HorizontalScrollBarVisibility="Auto"
                                           VerticalScrollBarVisibility="Auto"
                                           ShowLineNumbers="True"
                                           TextChanged="Editor_OnTextChanged" />
                    </Border>

                    <!-- Minimap(窄条,点击标题区域折叠/展开) -->
                    <Border Grid.Column="4" x:Name="MinimapHost" CornerRadius="10"
                            Background="{DynamicResource Color.SurfaceElevated}"
                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <RichTextBox x:Name="MinimapBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                         FontFamily="Consolas" Cursor="Hand"
                                         VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                                         MouseDown="Minimap_MouseDown" MouseWheel="Minimap_MouseWheel" />
                            <Canvas x:Name="MinimapViewportCanvas" IsHitTestVisible="False">
                                <Rectangle x:Name="MinimapViewport" Fill="#22FFFFFF" />
                            </Canvas>
                            <Button Style="{StaticResource WsMini}" Command="{Binding ToggleMinimapCommand}"
                                    Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,3,3,0" Content="‹" Background="Transparent" />
                        </Grid>
                    </Border>
                    <!-- minimap 折叠后的展开钮 -->
                    <Button Grid.Column="4" x:Name="MinimapExpand" Style="{StaticResource WsMini}" Width="26" Height="40"
                            Command="{Binding ToggleMinimapCommand}" Content="›"
                            Visibility="{Binding ShowMinimap, Converter={StaticResource InverseBoolToVisibility}}" />
                </Grid>

                <!-- ===== 效果预览视图 ===== -->
                <Grid Grid.Row="2" x:Name="PreviewHost" Visibility="Collapsed">
                    <StackPanel>
                        <Border x:Name="PreviewFrame" CornerRadius="10" ClipToBounds="False" Height="340"
                                Background="{DynamicResource Color.SurfaceElevated}"
                                SizeChanged="PreviewFrame_OnSizeChanged">
                            <Grid>
                                <Image x:Name="AfterImage" Source="{Binding PreviewImage}" Stretch="Uniform" />
                                <Image x:Name="BeforeImage" Source="{Binding BeforeImage}" Stretch="Uniform" />
                                <Canvas>
                                    <Rectangle x:Name="SplitLine" Width="2" Fill="{DynamicResource Color.Primary}" />
                                </Canvas>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                                        CornerRadius="8" Padding="8,2" Background="{DynamicResource Brush.Glass}">
                                    <TextBlock Text="1 / 1" FontSize="10.5" Foreground="{DynamicResource Color.Text.Secondary}" />
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{loc:Translate Workshop.Before}" FontSize="10.5"
                                       Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center" />
                            <Slider Grid.Column="1" Style="{StaticResource VioraSlider}" Margin="8,0" Minimum="0" Maximum="100"
                                    Value="{Binding ComparePosition}" VerticalAlignment="Center"
                                    ValueChanged="CompareSlider_OnValueChanged" />
                            <TextBlock Grid.Column="2" Text="{loc:Translate Workshop.After}" FontSize="10.5"
                                       Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource WsButton}" Command="{Binding PickSampleCommand}"
                                    Content="{loc:Translate Workshop.PickSample}" />
                            <Button Style="{StaticResource WsButton}" Command="{Binding RunPreviewCommand}" Margin="8,0,0,0"
                                    IsEnabled="{Binding CanRun}" Content="{loc:Translate Workshop.Run}" />
                            <TextBlock Text="{Binding SampleInfoText}" FontSize="10.5" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Color.Text.Disabled}" />
                        </StackPanel>
                        <!-- 参数调节(可折叠) -->
                        <Expander Margin="0,10,0,0" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock Text="{loc:Translate Workshop.Params}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding PreviewParameters}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                                                       Foreground="{DynamicResource Color.Text.Secondary}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Label}" />
                                            <Slider Grid.Column="1" Style="{StaticResource VioraSlider}" Margin="6,0"
                                                    Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                    Value="{Binding Value, Mode=TwoWay}"
                                                    TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" ValueChanged="ParamSlider_OnValueChanged" />
                                            <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:0.0#}}" FontSize="11"
                                                       Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Grid>

                <!-- 输出 -->
                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <RadioButton x:Name="TabBuild" Content="{loc:Translate Workshop.TabBuild}" GroupName="WsOut"
                                     IsChecked="True" Style="{StaticResource WsOutTab}" Checked="OutTab_OnChecked" />
                        <RadioButton Content="{loc:Translate Workshop.TabRun}" GroupName="WsOut"
                                     Style="{StaticResource WsOutTab}" Margin="4,0,0,0" Checked="OutTab_OnChecked" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleCheck}" Width="10" Height="10"
                                            Foreground="{DynamicResource Color.Success}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ReadyText}" FontSize="11" Margin="5,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Color.Text.Disabled}" />
                                        <ToggleButton x:Name="OutputCollapse" Width="20" Height="20" Margin="8,0,0,0" Cursor="Hand"
                                                      IsChecked="True" FocusVisualStyle="{x:Null}"
                                                      Checked="OutputCollapse_OnChecked" Unchecked="OutputCollapse_OnChecked">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{DynamicResource Brush.Glass}" CornerRadius="6">
                                                        <TextBlock x:Name="Chevron" Text="▾" FontSize="10" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" Foreground="{DynamicResource Color.Text.Secondary}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="False">
                                                            <Setter TargetName="Chevron" Property="Text" Value="▸" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </StackPanel>
                                </Grid>
                                <Border x:Name="OutputBorder" Grid.Row="5" CornerRadius="10" BorderBrush="{DynamicResource Color.Border}" BorderThickness="1"
                                        Background="{DynamicResource Color.SurfaceElevated}" Margin="0,6,0,0">
                    <TextBox x:Name="OutputBox" FontFamily="Consolas" FontSize="11.5"
                             Foreground="{DynamicResource Color.Text.Secondary}" Background="Transparent" BorderThickness="0"
                             Padding="10,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True" TextChanged="Output_OnTextChanged"
                             Text="{Binding OutputLog, Mode=OneWay}" />
                </Border>
            </Grid>
        </Border>

        <!-- ============ 右:卡片 ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 打包 zip(信息卡上方) -->
                <Button Style="{StaticResource WsButton}" Command="{Binding PackZipCommand}" HorizontalAlignment="Stretch"
                        IsEnabled="{Binding CanRun}" Background="{DynamicResource Brush.Brand}" Foreground="White"
                        BorderThickness="0" Height="40" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <controls:VioraIcon Geometry="{StaticResource Icon.Download}" Width="13" Height="13" Foreground="White" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Translate Workshop.Pack}" FontSize="13" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- 相关信息 -->
                <Border Style="{StaticResource WsCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <controls:VioraIcon Geometry="{StaticResource Icon.PuzzlePiece}" Width="13" Height="13"
                                                    Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Workshop.InfoTitle}" FontSize="13.5" FontWeight="Bold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                            </StackPanel>
                            <Button Style="{StaticResource WsMini}" Command="{Binding AddInfoCommand}" HorizontalAlignment="Right"
                                    Content="+" IsEnabled="{Binding HasAddableLanguages}"
                                    ToolTip="{loc:Translate Workshop.InfoAdd}" />
                        </Grid>

                        <TextBlock Text="{loc:Translate Workshop.PluginId}" Style="{StaticResource WsLabel}" />
                        <TextBox Style="{StaticResource WsInput}" Text="{Binding PluginId, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{loc:Translate Workshop.Author}" Style="{StaticResource WsLabel}" />
                                <TextBox Style="{StaticResource WsInput}" Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{loc:Translate Workshop.Version}" Style="{StaticResource WsLabel}" />
                                <TextBox Style="{StaticResource WsInput}" Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{loc:Translate Workshop.Category}" Style="{StaticResource WsLabel}" />
                        <ComboBox Style="{StaticResource VioraCombo}" ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding CategoryDisplay}" />

                        <!-- 语言条目:默认英语(固定),+ 增补其他语言 -->
                        <ItemsControl ItemsSource="{Binding InfoEntries}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="10,8" Margin="0,8,0,0"
                                            Background="{DynamicResource Color.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Style="{StaticResource WsLangChip}">
                                                        <TextBlock Text="{Binding LangDisplay}" FontSize="11"
                                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                                    </Border>
                                                    <TextBlock Text="{loc:Translate Workshop.InfoFixedHint}" FontSize="10" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center"
                                                               Visibility="{Binding IsFixed, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <Button Style="{StaticResource WsMini}" HorizontalAlignment="Right"
                                                        Command="{Binding DataContext.RemoveInfoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Content="−"
                                                        IsEnabled="{Binding IsFixed, Converter={StaticResource InverseBool}}" />
                                            </Grid>
                                            <TextBlock Text="{loc:Translate Workshop.InfoName}" Style="{StaticResource WsLabel}" />
                                            <TextBox Style="{StaticResource WsInput}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Text="{loc:Translate Workshop.InfoDesc}" Style="{StaticResource WsLabel}" />
                                            <TextBox Style="{StaticResource WsInputMultiline}"
                                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- registry 条目 -->
                <Border Style="{StaticResource WsCard}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <controls:VioraIcon Geometry="{StaticResource Icon.TableCells}" Width="13" Height="13"
                                                    Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Workshop.Registry}" FontSize="13.5" FontWeight="Bold" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Color.Text.Primary}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource WsButton}" Command="{Binding GenerateRegistryCommand}"
                                        Padding="8,3" FontSize="11" Content="{loc:Translate Workshop.GenRegistry}" />
                                <Button Style="{StaticResource WsButton}" Command="{Binding CopyRegistryCommand}" Padding="8,3"
                                        FontSize="11" Margin="6,0,0,0" Content="{loc:Translate Common.Copy}" />
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="10" BorderBrush="{DynamicResource Color.Border}" BorderThickness="1"
                                Background="{DynamicResource Color.SurfaceElevated}" Margin="0,10,0,0">
                            <RichTextBox x:Name="RegistryBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                                         Background="Transparent" BorderThickness="0" Padding="10,8"
                                         VerticalScrollBarVisibility="Auto" MinHeight="120" MaxHeight="260" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
