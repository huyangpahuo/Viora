<UserControl
    x:Class="Viora.UI.Pages.PluginMarket.PluginMarketPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:loc="clr-namespace:Viora.UI.Localization">

    <!--
        插件市场:Hero 横幅 + 分类 Tab/搜索 + 插件卡片网格(分页)+ 右侧详情面板。
        当前为测试插件目录(无服务器);安装/卸载为本地模拟并持久化,
        接真实后端时只换数据源与安装实现。
    -->

    <UserControl.Resources>
        <!-- 搜索输入(与我的作品一致) -->
        <Style x:Key="MarketSearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Color.Primary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid Background="Transparent">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="0,8" />
                            <TextBlock Text="{TemplateBinding Tag}" FontSize="12.5" FontFamily="{StaticResource Font.Family}"
                                       Foreground="{DynamicResource Color.Text.Disabled}" VerticalAlignment="Center"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringEmptyToVisibility}}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签胶囊 -->
        <Style x:Key="TagPill" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Glass}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8,2.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 插件卡片容器 -->
        <Style x:Key="MarketCardItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片安装按钮:未安装 = 品牌胶囊;已安装 = 玻璃胶囊(打勾) -->
        <Style x:Key="CardInstallButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 未安装:安装 -->
                            <Border x:Name="Install" Background="{DynamicResource Brush.Brand}" CornerRadius="10" Padding="16,5">
                                <TextBlock Text="{loc:Translate Market.Install}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                            </Border>
                            <!-- 安装中:下载 → 校验 → 安装 → 启用 -->
                            <Border x:Name="Installing" Background="{DynamicResource Color.SurfaceHigh}" CornerRadius="10" Padding="12,5"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Width="26" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Color.Primary}" Background="{DynamicResource Color.Border}"
                                                 BorderThickness="0" />
                                    <TextBlock Text="{loc:Translate Market.Installing}" FontSize="11" Margin="8,0,0,0"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                </StackPanel>
                            </Border>
                            <!-- 已安装:玻璃 + 打勾 -->
                            <Border x:Name="Installed" Background="{DynamicResource Brush.GlassStrong}" CornerRadius="10" Padding="12,5"
                                    BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <controls:VioraIcon Geometry="{StaticResource Icon.CircleCheck}" Width="11" Height="11"
                                                        Foreground="{DynamicResource Color.Success}" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Translate Market.Installed}" FontSize="11.5" Margin="6,0,0,0"
                                               Foreground="{DynamicResource Color.Text.Primary}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                <Setter TargetName="Install" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Installed" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsInstallingThis}" Value="True">
                                <Setter TargetName="Install" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Installing" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsInstalled}" Value="False" />
                                    <Condition Binding="{Binding IsInstallingThis}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Install" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Installing" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Installed" Property="Visibility" Value="Collapsed" />
                            </MultiDataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Install" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,14,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 市场(左) ==================== -->
        <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="14" Padding="16,14"
                Background="{DynamicResource Color.Surface}" BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Hero 横幅 -->
                <Border Grid.Row="0" CornerRadius="13" ClipToBounds="True" Margin="0,0,0,14">
                    <Grid>
                        <Border Background="{DynamicResource Color.SurfaceElevated}" />
                        <Border Background="{DynamicResource Brush.BrandSoft}" Opacity="0.5" />
                        <controls:VioraIcon Geometry="{StaticResource Icon.PuzzlePiece}" Width="150" Height="150" Opacity="0.10"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,-18" Foreground="White" />
                        <controls:VioraIcon Geometry="{StaticResource Icon.WandMagicSparkles}" Width="90" Height="90" Opacity="0.10"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-16,240,0" Foreground="White" />
                        <Grid Margin="20,16">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Translate Nav.PluginMarket}" FontSize="22" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{loc:Translate Market.Subtitle}" FontSize="12" Margin="0,6,0,0" Foreground="#D8DCF5" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <controls:VioraIcon Geometry="{StaticResource Icon.WandMagicSparkles}" Width="14" Height="14" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Translate Market.Feature.Styles}" FontSize="11.5" Margin="7,0,0,0" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <controls:VioraIcon Geometry="{StaticResource Icon.ClockRotateLeft}" Width="14" Height="14" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Translate Market.Feature.Updates}" FontSize="11.5" Margin="7,0,0,0" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                                    <controls:VioraIcon Geometry="{StaticResource Icon.CloudArrowDown}" Width="14" Height="14" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                    <TextBlock Text="{loc:Translate Market.Feature.Install}" FontSize="11.5" Margin="7,0,0,0" Foreground="#D8DCF5" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 分类 Tab + 搜索 -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="262" />
                    </Grid.ColumnDefinitions>
                    <ListBox BorderThickness="0" Background="Transparent" Padding="0"
                             ItemsSource="{Binding TabFilters}" SelectedItem="{Binding TabFilter}"
                             ItemContainerStyle="{StaticResource ChipPillItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Visible">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource TranslateKey}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Column="2" Width="262" Height="34" Background="{DynamicResource Color.SurfaceElevated}"
                            CornerRadius="10" BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1" Padding="10,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <controls:VioraIcon Geometry="{StaticResource Icon.MagnifyingGlass}" Width="13" Height="13"
                                                Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource MarketSearchBox}" Margin="20,0,0,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="{loc:Translate Market.Search.Placeholder}" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- 卡片网格 + 分页 -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="MarketScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="OnListWheel">
                        <ListBox BorderThickness="0" Background="Transparent" Margin="-6,0,-6,0"
                                 ItemsSource="{Binding Cards}" SelectedItem="{Binding SelectedCard}"
                                 ItemContainerStyle="{StaticResource MarketCardItem}"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Width="214" Margin="6,6" CornerRadius="13" Padding="9"
                                            Background="{DynamicResource Color.SurfaceElevated}"
                                            BorderBrush="{DynamicResource Color.Border}" BorderThickness="1.4">
                                        <StackPanel>
                                            <!-- 预览图:有真实截图用截图,否则回退默认渐变(网络不佳/未上传) -->
                                            <Border Height="118" CornerRadius="9">
                                                <Grid>
                                                    <Border Background="{Binding Model.TileBrush}"
                                                            Visibility="{Binding HasPreviewImage, Converter={StaticResource InverseBoolToVisibility}}">
                                                        <controls:VioraIcon Geometry="{StaticResource Icon.WandMagicSparkles}" Width="26" Height="26"
                                                                            Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding Model.PreviewImage}" Stretch="UniformToFill"
                                                           Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="7,7,0,0" CornerRadius="8" Padding="8,2"
                                                            Background="{DynamicResource Brush.Brand}"
                                                            Visibility="{Binding Model.IsRecommended, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{loc:Translate Stylize.Panel.Recommended}" FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
                                                    </Border>
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,7,0" CornerRadius="8" Padding="8,2"
                                                            Background="{DynamicResource Color.Scrim}"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{loc:Translate Market.Installed}" FontSize="9.5" Foreground="{DynamicResource Color.Success}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Margin="4,9,4,0"
                                                       Foreground="{DynamicResource Color.Text.Primary}" TextTrimming="CharacterEllipsis" />

                                            <!-- 作者 + 认证(点击 → 打开插件 GitHub 仓库;官方 = packages 内的包,第三方 = 作者配置) -->
                                            <Button HorizontalAlignment="Left" Command="{Binding OpenRepositoryCommand}"
                                                    ToolTip="{Binding AuthorTooltip}" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <StackPanel x:Name="AuthorRow" Orientation="Horizontal" Background="Transparent">
                                                            <controls:VioraIcon Geometry="{StaticResource Icon.CircleUser}" Width="13" Height="13"
                                                                                Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                                                            <TextBlock x:Name="AuthorText" Text="{Binding Author}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                                                            <controls:VioraIcon Geometry="{StaticResource Icon.CircleCheck}" Width="11" Height="11" Margin="5,0,0,0"
                                                                                Foreground="{DynamicResource Color.Secondary}" VerticalAlignment="Center"
                                                                                Visibility="{Binding IsVerified, Converter={StaticResource BoolToVisibility}}" />
                                                        </StackPanel>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="AuthorText" Property="Foreground" Value="{DynamicResource Color.Primary}" />
                                                                <Setter TargetName="AuthorText" Property="TextDecorations" Value="Underline" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <!-- 标签(分类 + 作者自配,数量不定) -->
                                            <ItemsControl Margin="4,7,4,0" ItemsSource="{Binding Model.Tags}" HorizontalAlignment="Left">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource TagPill}" Margin="0,0,6,0">
                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Color.Text.Secondary}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 评分 + 安装 -->
                                            <Grid Margin="4,10,4,2">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:VioraIcon Geometry="{StaticResource Icon.Star}" Width="12" Height="12"
                                                                        Foreground="{DynamicResource Color.Warning}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding RatingText}" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0"
                                                               Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding InstallsDisplay}" FontSize="10.5" Margin="9,0,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                                </StackPanel>
                                                <Button Style="{StaticResource CardInstallButton}" HorizontalAlignment="Right"
                                                        Command="{Binding InstallCommand}" IsEnabled="{Binding CanInstall}" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                            <Setter TargetName="Card" Property="Effect" Value="{DynamicResource Shadow.PrimaryGlow}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <controls:Pager Grid.Row="1" Margin="0,8,0,0" PageSize="9"
                                    TotalItems="{Binding TotalItems}" CurrentPage="{Binding Page, Mode=TwoWay}"
                                    Visibility="{Binding PagerVisible, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 空状态 -->
                    <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasCards, Converter={StaticResource InverseBoolToVisibility}}">
                        <Border Width="70" Height="70" CornerRadius="20" HorizontalAlignment="Center"
                                Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1">
                            <controls:VioraIcon Geometry="{StaticResource Icon.PuzzlePiece}" Width="28" Height="28"
                                                Foreground="{DynamicResource Color.Primary}" />
                        </Border>
                        <TextBlock FontSize="13" Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Color.Text.Secondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Translate Market.Empty}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowMineEmpty}" Value="True">
                                            <Setter Property="Text" Value="{loc:Translate Market.Mine.Empty}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ==================== 插件详情 / 全部插件(右) ==================== -->
        <Border Grid.Column="1" CornerRadius="14" Padding="16,14" Background="{DynamicResource Color.Surface}"
                BorderBrush="{DynamicResource Color.Border}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 面板头:全部插件切换 + 数量 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <ToggleButton HorizontalAlignment="Left" IsChecked="{Binding ShowAllPlugins, Mode=TwoWay}"
                                  FocusVisualStyle="{x:Null}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Pill" Background="Transparent" CornerRadius="999" Padding="13,6"
                                        BorderBrush="{DynamicResource Color.Outline}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:VioraIcon Geometry="{StaticResource Icon.PuzzlePiece}" Width="12" Height="12"
                                                            Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="Label" Text="{loc:Translate Market.All.Plugins}" FontSize="11.5" FontWeight="SemiBold"
                                                   Margin="7,0,0,0" Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.StateHover}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.Primary}" />
                                        <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <TextBlock Text="{Binding AllHeaderText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               FontSize="11" Foreground="{DynamicResource Color.Text.Disabled}" />
                </Grid>

                <!-- 详情 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding ShowAllPlugins, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">

                    <!-- 大预览:有真实截图用截图,否则回退默认渐变 -->
                    <Border Height="196" CornerRadius="12">
                        <Grid>
                            <Border Background="{Binding SelectedCard.Model.TileBrush}"
                                    Visibility="{Binding SelectedCard.HasPreviewImage, Converter={StaticResource InverseBoolToVisibility}}">
                                <controls:VioraIcon Geometry="{StaticResource Icon.WandMagicSparkles}" Width="40" Height="40"
                                                    Foreground="#40FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Image Source="{Binding SelectedCard.Model.PreviewImage}" Stretch="UniformToFill"
                                   Visibility="{Binding SelectedCard.HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" CornerRadius="9" Padding="10,3"
                                    Background="{DynamicResource Color.Scrim}"
                                    Visibility="{Binding SelectedCard.IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{loc:Translate Market.Installed}" FontSize="11" Foreground="{DynamicResource Color.Success}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 名称 / 作者 / 评分 -->
                    <TextBlock Text="{Binding SelectedCard.Name}" FontSize="19" FontWeight="Bold" Margin="2,14,0,0"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <StackPanel Orientation="Horizontal" Margin="2,8,0,0">
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleUser}" Width="14" Height="14"
                                            Foreground="{DynamicResource Color.Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedCard.Author}" FontSize="12" Margin="7,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleCheck}" Width="12" Height="12" Margin="7,0,0,0"
                                            Foreground="{DynamicResource Color.Secondary}" VerticalAlignment="Center"
                                            Visibility="{Binding SelectedCard.IsVerified, Converter={StaticResource BoolToVisibility}}" />
                        <controls:VioraIcon Geometry="{StaticResource Icon.Star}" Width="13" Height="13" Margin="16,0,0,0"
                                            Foreground="{DynamicResource Color.Warning}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedCard.RatingDetailText}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0"
                                   Foreground="{DynamicResource Color.Text.Primary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 标签(分类 + 作者自配,数量不定) -->
                    <ItemsControl Margin="2,11,0,0" ItemsSource="{Binding SelectedCard.Model.Tags}" HorizontalAlignment="Left">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource TagPill}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding}" FontSize="10.5" Foreground="{DynamicResource Color.Text.Secondary}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 描述 -->
                    <TextBlock Text="{Binding SelectedCard.Model.Description}" FontSize="12" Margin="2,12,4,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Color.Text.Secondary}" />

                    <!-- 元信息 -->
                    <TextBlock Text="{Binding SelectedCard.MetaLine}" FontSize="10.5" Margin="2,12,0,0"
                               Foreground="{DynamicResource Color.Text.Disabled}" />

                    <!-- 操作按钮 -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 已安装态:玻璃 + 打勾(禁用);未安装态:品牌安装按钮 -->
                        <Button Grid.Column="0" Height="42" Command="{Binding SelectedCard.InstallCommand}"
                                IsEnabled="{Binding SelectedCard.CanInstall}" FocusVisualStyle="{x:Null}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Brand" Background="{DynamicResource Brush.Brand}" CornerRadius="12"
                                                Effect="{DynamicResource Shadow.BrandGlow}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:VioraIcon Geometry="{StaticResource Icon.CloudArrowDown}" Width="15" Height="15" Foreground="White" />
                                                <TextBlock Text="{loc:Translate Market.Install}" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="White" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="Done" Background="{DynamicResource Brush.Brand}" CornerRadius="12"
                                                Effect="{DynamicResource Shadow.BrandGlow}" Visibility="Collapsed">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <controls:VioraIcon Geometry="{StaticResource Icon.CircleCheck}" Width="15" Height="15" Foreground="White" />
                                                <TextBlock Text="{loc:Translate Market.Installed}" FontSize="13.5" FontWeight="Bold"
                                                           Foreground="White" Margin="9,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCard.IsInstalled}" Value="True">
                                            <Setter TargetName="Brand" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Brand" Property="Opacity" Value="0.93" />
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding SelectedCard.IsInstalled}" Value="False" />
                                                <Condition Binding="{Binding IsEnabled}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Brand" Property="Opacity" Value="0.45" />
                                            <Setter TargetName="Brand" Property="Effect" Value="{x:Null}" />
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="42" Padding="16,0"
                                Command="{Binding SelectedCard.UninstallCommand}"
                                Visibility="{Binding SelectedCard.IsInstalled, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <controls:VioraIcon Geometry="{StaticResource Icon.TrashCan}" Width="13" Height="13"
                                                    Foreground="{DynamicResource Color.Danger}" />
                                <TextBlock Text="{loc:Translate Market.Uninstall}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Separator Margin="0,14,0,0" Background="{DynamicResource Color.Divider}" />

                    <!-- 效果预览 -->
                    <TextBlock Text="{loc:Translate Market.Detail.Preview}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,10"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Border Height="96" CornerRadius="10" Background="{Binding SelectedCard.Model.BeforeBrush}" />
                            <TextBlock Text="{loc:Translate Market.Detail.Before}" FontSize="10.5" Margin="2,5,0,0"
                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Border Height="96" CornerRadius="10" Background="{Binding SelectedCard.Model.AfterBrush}" />
                            <TextBlock Text="{loc:Translate Stylize.Badge.Stylized}" FontSize="10.5" Margin="2,5,0,0"
                                       Foreground="{DynamicResource Color.Text.Secondary}" />
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,14,0,0" Background="{DynamicResource Color.Divider}" />

                    <!-- 插件信息 -->
                    <TextBlock Text="{loc:Translate Market.Detail.Info}" FontSize="13" FontWeight="SemiBold" Margin="2,12,0,10"
                               Foreground="{DynamicResource Color.Text.Primary}" />
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{loc:Translate Market.Detail.Developer}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                        <TextBlock Text="{Binding SelectedCard.Author}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </Grid>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{loc:Translate Market.Detail.Category}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                        <TextBlock Text="{Binding SelectedCard.TagsDisplay}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </Grid>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{loc:Translate Market.Detail.Formats}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                        <TextBlock Text="{loc:Translate Market.Detail.FormatsValue}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </Grid>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="{loc:Translate Market.Detail.HostVersion}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" />
                        <TextBlock Text="{loc:Translate Market.Detail.HostVersionValue}" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Color.Text.Primary}" />
                    </Grid>

                    <!-- 更新日志(可展开) -->
                    <ToggleButton x:Name="ChangelogToggle" HorizontalAlignment="Left" Margin="2,10,0,0" FocusVisualStyle="{x:Null}" Cursor="Hand">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent" Padding="2,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{loc:Translate Market.Detail.Changelog}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Color.Primary}" VerticalAlignment="Center" />
                                        <controls:VioraIcon x:Name="Chevron" Geometry="{StaticResource Icon.ChevronRight}" Width="10" Height="10"
                                                            Margin="7,1,0,0" RenderTransformOrigin="0.5,0.5"
                                                            Foreground="{DynamicResource Color.Primary}">
                                            <controls:VioraIcon.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </controls:VioraIcon.RenderTransform>
                                        </controls:VioraIcon>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(RenderTransform).Angle"
                                                                     To="90" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(RenderTransform).Angle"
                                                                     To="0" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <ItemsControl Margin="2,8,0,4" ItemsSource="{Binding SelectedCard.Model.Changelog}"
                                  Visibility="{Binding IsChecked, ElementName=ChangelogToggle, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{Binding Date}" FontSize="10.5" Margin="10,1,0,0"
                                                   Foreground="{DynamicResource Color.Text.Disabled}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="2,5,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <Ellipse Width="3.5" Height="3.5" Fill="{DynamicResource Color.Text.Disabled}"
                                                             VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding}" FontSize="11.5" Margin="8,0,0,0"
                                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </ScrollViewer>

                <!-- 全部插件:完整目录(不分页、不受左侧 Tab/搜索影响),点击查看详情 -->
                <ListBox Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,0,4,0"
                         ItemsSource="{Binding AllCards}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         Visibility="{Binding ShowAllPlugins, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Button HorizontalContentAlignment="Stretch" Padding="0"
                                    Command="{Binding DataContext.SelectAllCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" FocusVisualStyle="{x:Null}" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="9" Padding="10,8" Margin="0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Color.Text.Primary}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Author}" FontSize="10.5" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Color.Text.Secondary}" />
                                                </StackPanel>
                                                <controls:VioraIcon Grid.Column="1" Geometry="{StaticResource Icon.CircleCheck}" Width="13" Height="13"
                                                                    Foreground="{DynamicResource Color.Success}" VerticalAlignment="Center"
                                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Color.StateHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
