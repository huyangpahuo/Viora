<UserControl
    x:Class="Viora.UI.Pages.Convert.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:pages="clr-namespace:Viora.UI.Pages">

    <!--
        Convert: viewport + parameter panel. The viewport keeps the image fit inside a
        fixed content box (code-behind), with zoom/pan (放大镜) and a switchable compare
        mode: 原图 / 分屏 / 并排 / 结果 — split is the default. Selecting a preset
        converts immediately; 重置 / 导出 / 更换图片 live above the preset strip.
    -->
    <pages:PageChrome TitleKey="Convert.Title" SubtitleKey="Convert.Subtitle">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="PanelColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Viewport -->
            <Border x:Name="ViewportBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Background="{DynamicResource Color.Surface}" CornerRadius="{DynamicResource Radius.Large}"
                    BorderBrush="{DynamicResource Color.Border}" BorderThickness="1"
                    AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" ClipToBounds="True"
                    MouseLeftButtonDown="OnViewportMouseDown" MouseMove="OnViewportMouseMove" MouseLeftButtonUp="OnViewportMouseUp"
                    PreviewMouseWheel="OnViewportWheel">
                <Grid>
                    <!-- Zoom/pan transform applies to every image view state. -->
                    <Grid x:Name="ZoomHost" RenderTransformOrigin="0.5,0.5" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                <TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!-- 1) Original only (or result pending) -->
                        <Image Source="{Binding OriginalImageSource}" Stretch="Uniform" Margin="16"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Visibility="{Binding ShowOriginalOnly, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 2) Result only -->
                        <Image Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="16"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Visibility="{Binding ShowResultOnly, Converter={StaticResource BoolToVisibility}}" />

                        <!-- 3) Side-by-side -->
                        <Grid Visibility="{Binding ShowCompareSide, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding OriginalImageSource}" Stretch="Uniform" Margin="16"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                            <Image Grid.Column="1" Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="16"
                                   RenderOptions.BitmapScalingMode="LowQuality" />
                        </Grid>

                        <!-- 4) Before/After split. CompareRoot is sized in code-behind to the
                             exact letterboxed image bounds, so divider, clip and badges
                             share one coordinate space. -->
                        <Grid Visibility="{Binding ShowCompareSplit, Converter={StaticResource BoolToVisibility}}" Cursor="SizeWE">
                            <Grid x:Name="CompareRoot" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="OriginalHost" Source="{Binding OriginalImageSource}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="LowQuality" />
                                <Image x:Name="ResultHost" Source="{Binding ResultImageSource}" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="LowQuality">
                                    <Image.Clip>
                                        <RectangleGeometry x:Name="ResultClip" Rect="0,0,0,0" />
                                    </Image.Clip>
                                </Image>

                                <Canvas x:Name="SplitOverlay" IsHitTestVisible="False">
                                    <Rectangle x:Name="DividerLine" Width="2" RadiusX="1" RadiusY="1"
                                               Fill="{DynamicResource Color.Primary}" />
                                    <Border x:Name="DividerGrip" Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource Color.Primary}" BorderBrush="{DynamicResource Color.OnPrimary}"
                                            BorderThickness="2" Effect="{DynamicResource Shadow.CardHover}">
                                        <TextBlock Text="&#xE76B;&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                   Foreground="{DynamicResource Color.OnPrimary}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Canvas>

                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                                        Background="{DynamicResource Color.Scrim}" CornerRadius="12" Padding="10,4">
                                    <TextBlock Text="{loc:Translate Convert.Original}" FontSize="11.5" Foreground="{DynamicResource Color.Text.Primary}" />
                                </Border>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                        Background="{DynamicResource Color.PrimaryContainer}" CornerRadius="12" Padding="10,4">
                                    <TextBlock Text="{loc:Translate Convert.Result}" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Color.OnPrimaryContainer}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Split drag surface: near the divider → split drag, elsewhere → pan.
                         Sits directly above the image but BELOW every overlay control, so
                         the mode switcher / zoom bar / dropzone stay clickable. -->
                    <Canvas x:Name="SplitHandle" Background="Transparent" AllowDrop="True" Cursor="SizeWE"
                            Drop="OnDrop" DragOver="OnDragOver"
                            MouseLeftButtonDown="OnSplitDown" MouseMove="OnSplitMove" MouseLeftButtonUp="OnSplitUp" />

                    <!-- Compare mode switcher (top center) -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                            Background="{DynamicResource Color.Scrim}" CornerRadius="17" Padding="4"
                            Visibility="{Binding CanCompare, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="CompareMode" Style="{DynamicResource ModePill}" Content="{loc:Translate Convert.Original}"
                                         IsChecked="{Binding CompareMode, Converter={StaticResource Equals}, ConverterParameter=Original, Mode=TwoWay}" />
                            <RadioButton GroupName="CompareMode" Style="{DynamicResource ModePill}" Content="{loc:Translate Convert.CompareSplit}"
                                         IsChecked="{Binding CompareMode, Converter={StaticResource Equals}, ConverterParameter=Split, Mode=TwoWay}" />
                            <RadioButton GroupName="CompareMode" Style="{DynamicResource ModePill}" Content="{loc:Translate Convert.CompareSide}"
                                         IsChecked="{Binding CompareMode, Converter={StaticResource Equals}, ConverterParameter=SideBySide, Mode=TwoWay}" />
                            <RadioButton GroupName="CompareMode" Style="{DynamicResource ModePill}" Content="{loc:Translate Convert.Result}"
                                         IsChecked="{Binding CompareMode, Converter={StaticResource Equals}, ConverterParameter=Result, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- Zoom bar (bottom right) -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12"
                            Background="{DynamicResource Color.Scrim}" CornerRadius="17" Padding="8,4"
                            Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{DynamicResource IconButton}" Command="{Binding ZoomOutCommand}" ToolTip="{loc:Translate Convert.ZoomOut}">
                                <TextBlock Text="&#xE738;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                            <TextBlock Text="{Binding ZoomPercent}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}"
                                       VerticalAlignment="Center" MinWidth="42" TextAlignment="Center" />
                            <Button Style="{DynamicResource IconButton}" Command="{Binding ZoomInCommand}" ToolTip="{loc:Translate Convert.ZoomIn}">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                            <Button Style="{DynamicResource IconButton}" Command="{Binding ZoomFitCommand}" ToolTip="{loc:Translate Convert.ZoomFit}">
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Dropzone: whole viewport is one browse button when empty -->
                    <Button Command="{Binding ImportCommand}"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Cursor="Hand">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="84" Height="84" Background="{DynamicResource Color.SurfaceElevated}"
                                                CornerRadius="{DynamicResource Radius.XLarge}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                       Foreground="{DynamicResource Color.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{DynamicResource Typography.Heading}" Text="{loc:Translate Convert.Dropzone.Title}"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                                        <TextBlock Style="{DynamicResource Typography.Caption}" Text="{loc:Translate Convert.Dropzone.Subtitle}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Progress rail -->
                    <Border VerticalAlignment="Bottom" Background="{DynamicResource Color.Scrim}" Padding="14,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <StackPanel>
                                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                             Foreground="{DynamicResource Color.Primary}" Background="{DynamicResource Color.SurfaceHigh}"
                                             BorderThickness="0" />
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                            <Button Style="{DynamicResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Command="{Binding CancelCommand}" ToolTip="{loc:Translate Convert.Cancel}">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Parameter panel -->
            <ScrollViewer x:Name="PanelScroll" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Action row: replace / reset / export -->
                    <Grid Margin="0,2,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{DynamicResource SecondaryButton}" Padding="6,7"
                                Command="{Binding ImportCommand}" ToolTip="{loc:Translate Convert.ReplaceImage}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Convert.ReplaceImage}" FontSize="11.5" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{DynamicResource SecondaryButton}" Padding="6,7"
                                Command="{Binding ResetParametersCommand}" ToolTip="{loc:Translate Convert.Reset}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Convert.Reset}" FontSize="11.5" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Style="{DynamicResource SecondaryButton}" Padding="6,7"
                                Command="{Binding ExportCommand}" IsEnabled="{Binding CanCompare}"
                                ToolTip="{loc:Translate Convert.Export}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Translate Convert.Export}" FontSize="11.5" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Preset selector card: chip + pager on top, scrub slider below -->
                    <Border Style="{DynamicResource VioraCard}" Padding="14,12"
                            Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{DynamicResource IconButton}" Width="30" Height="30" Command="{Binding PreviousPresetCommand}"
                                        ToolTip="{loc:Translate Convert.PrevPreset}">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <Border Grid.Column="1" Background="{DynamicResource Color.PrimaryContainer}"
                                        CornerRadius="{DynamicResource Radius.Medium}" Padding="14,5" Margin="8,0"
                                        HorizontalAlignment="Center" MaxWidth="150"
                                        ToolTip="{Binding SelectedPreset.Description}">
                                    <TextBlock Text="{Binding SelectedPreset.Name}" FontWeight="SemiBold" FontSize="13.5"
                                               Foreground="{DynamicResource Color.OnPrimaryContainer}" TextTrimming="CharacterEllipsis" />
                                </Border>
                                <Button Grid.Column="2" Style="{DynamicResource IconButton}" Width="30" Height="30" Command="{Binding NextPresetCommand}"
                                        ToolTip="{loc:Translate Convert.NextPreset}">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <TextBlock Grid.Column="3" Text="{Binding PresetPosition}" FontSize="12" MinWidth="46" TextAlignment="Right"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Color.Text.Secondary}" />
                            </Grid>
                            <Slider Style="{DynamicResource VioraSlider}" Margin="4,10,4,0"
                                    Minimum="0" Maximum="{Binding PresetSliderMax}"
                                    Value="{Binding SelectedPresetIndex, Mode=TwoWay}"
                                    IsSnapToTickEnabled="True" TickFrequency="1"
                                    IsEnabled="{Binding HasPresets}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="14" Text="{loc:Translate Convert.Parameters}" Margin="0,14,0,10" />
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{Binding ValueDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Color.Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Style="{DynamicResource VioraSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                            Value="{Binding SliderValue, Mode=TwoWay}" TickFrequency="{Binding Step}"
                                            IsSnapToTickEnabled="True" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource Color.Text.Disabled}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap"
                               Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" Margin="0,4,0,8" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </pages:PageChrome>
</UserControl>
