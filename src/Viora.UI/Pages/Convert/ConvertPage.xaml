<UserControl
    x:Class="Viora.UI.Pages.Convert.ConvertPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:Viora.UI.Localization"
    xmlns:pages="clr-namespace:Viora.UI.Pages">

    <!--
        Convert: viewport + parameter panel. Responsive: below 1000px the panel
        stacks under the viewport (arranged in code-behind). The whole viewport
        accepts drops in every state; when no image is loaded it is one big
        browse button (no duplicated dropzone UI).
    -->
    <pages:PageChrome TitleKey="Convert.Title" SubtitleKey="Convert.Subtitle">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="PanelColumn" Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Viewport -->
            <Border x:Name="ViewportBorder" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Background="{DynamicResource Color.Surface}" CornerRadius="{DynamicResource Radius.Large}"
                    BorderBrush="{DynamicResource Color.Border}" BorderThickness="1"
                    AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" ClipToBounds="True">
                <Grid>
                    <!-- 1) Original only (loaded, result pending/failed) -->
                    <Image Source="{Binding OriginalImageSource}" Stretch="Uniform" Margin="16"
                           Visibility="{Binding ShowOriginalOnly, Converter={StaticResource BoolToVisibility}}" />

                    <!-- 2) Before/After split -->
                    <Grid Visibility="{Binding ShowCompareSplit, Converter={StaticResource BoolToVisibility}}" Cursor="SizeWE">
                        <Image x:Name="OriginalHost" Source="{Binding OriginalImageSource}" Stretch="Uniform" Margin="16" />
                        <Image x:Name="ResultHost" Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="16">
                            <Image.Clip>
                                <RectangleGeometry x:Name="ResultClip" Rect="0,0,0,0" />
                            </Image.Clip>
                        </Image>

                        <Canvas x:Name="SplitOverlay" IsHitTestVisible="False">
                            <Rectangle x:Name="DividerLine" Width="2" RadiusX="1" RadiusY="1"
                                       Fill="{DynamicResource Color.Primary}" />
                            <Border x:Name="DividerGrip" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource Color.Primary}" BorderBrush="{DynamicResource Color.OnPrimary}"
                                    BorderThickness="2" Effect="{DynamicResource Shadow.CardHover}">
                                <TextBlock Text="&#xE76B;&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource Color.OnPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Canvas>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0"
                                Background="{DynamicResource Color.Scrim}" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{loc:Translate Convert.Original}" FontSize="11.5" Foreground="{DynamicResource Color.Text.Primary}" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                Background="{DynamicResource Color.PrimaryContainer}" CornerRadius="12" Padding="10,4">
                            <TextBlock Text="{loc:Translate Convert.Result}" FontSize="11.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Color.OnPrimaryContainer}" />
                        </Border>

                        <Canvas x:Name="SplitHandle" Background="Transparent" AllowDrop="True"
                                Drop="OnDrop" DragOver="OnDragOver"
                                MouseLeftButtonDown="OnSplitDown" MouseMove="OnSplitMove" MouseLeftButtonUp="OnSplitUp" />
                    </Grid>

                    <!-- 3) Side-by-side -->
                    <Grid Visibility="{Binding ShowCompareSide, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{Binding OriginalImageSource}" Stretch="Uniform" Margin="16" />
                        <Image Grid.Column="1" Source="{Binding ResultImageSource}" Stretch="Uniform" Margin="16" />
                    </Grid>

                    <!-- 4) Dropzone: whole viewport is one browse button when empty -->
                    <Button Command="{Binding ImportCommand}"
                            Visibility="{Binding HasImage, Converter={StaticResource InverseBoolToVisibility}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Cursor="Hand">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="84" Height="84" Background="{DynamicResource Color.SurfaceElevated}"
                                                CornerRadius="{DynamicResource Radius.XLarge}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                       Foreground="{DynamicResource Color.Primary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Style="{DynamicResource Typography.Heading}" Text="{loc:Translate Convert.Dropzone.Title}"
                                                   HorizontalAlignment="Center" Margin="0,16,0,0" />
                                        <TextBlock Style="{DynamicResource Typography.Caption}" Text="{loc:Translate Convert.Dropzone.Subtitle}"
                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Progress rail -->
                    <Border VerticalAlignment="Bottom" Background="{DynamicResource Color.Scrim}" Padding="14,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding ProgressFraction, Mode=OneWay}"
                                         Foreground="{DynamicResource Color.Primary}" Background="{DynamicResource Color.SurfaceHigh}"
                                         BorderThickness="0" />
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Parameter panel -->
            <ScrollViewer x:Name="PanelScroll" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="14" Text="{loc:Translate Convert.Preset}" Margin="0,2,0,10" />
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource Color.Text.Primary}" />
                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Root" Background="{DynamicResource Color.SurfaceElevated}" CornerRadius="{DynamicResource Radius.Medium}"
                                                    Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="Transparent">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.PrimaryContainer}" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <TextBlock Style="{DynamicResource Typography.Heading}" FontSize="14" Text="{loc:Translate Convert.Parameters}" Margin="0,10,0,10" />
                    <ItemsControl ItemsSource="{Binding Parameters}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,14">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock Text="{Binding ValueDisplay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Color.Primary}" HorizontalAlignment="Right" />
                                    </Grid>
                                    <Slider Style="{DynamicResource VioraSlider}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                            Value="{Binding SliderValue, Mode=TwoWay}" TickFrequency="{Binding Step}"
                                            IsSnapToTickEnabled="True" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource Color.Text.Disabled}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{DynamicResource SecondaryButton}" Content="{loc:Translate Convert.Reset}" Command="{Binding ResetParametersCommand}" Margin="0,4,0,8" />
                    <Button Style="{DynamicResource VioraButton}" Content="{Binding ConvertButtonText}" Command="{Binding ConvertCommand}"
                            IsEnabled="{Binding HasImage}" Margin="0,0,0,8" />
                    <Button Style="{DynamicResource VioraButton}" Content="{loc:Translate Convert.Export}" Command="{Binding ExportCommand}" Margin="0,0,0,8"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap"
                               Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </pages:PageChrome>
</UserControl>
