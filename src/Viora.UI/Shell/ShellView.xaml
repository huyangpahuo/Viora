<UserControl
    x:Class="Viora.UI.Shell.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Viora.UI.Shell"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:shellns="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:loc="clr-namespace:Viora.UI.Localization">

    <!--
        Viora shell (v2 redesign): integrated top bar (brand / language / window
        controls) + fixed sidebar (core nav cards, brand decoration, aux links) +
        page host. Window chrome buttons and the language menu are caption-
        interactive via WindowChrome.IsHitTestVisibleInChrome.
    -->

    <UserControl.Resources>
        <!-- ============ 顶栏:语言按钮 + 深色菜单 ============ -->
        <Style x:Key="TopBarPillButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shellns:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Capsule}" Padding="10,5">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StatePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 窗口控制按钮 ============ -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="shellns:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StatePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFE81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FFC50E1D" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 侧栏导航(核心卡片) ============ -->
        <Style x:Key="NavCoreItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Margin="12,3" Padding="10,9" CornerRadius="13"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.BrandSoft}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#59FFFFFF" />
                                <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Shadow.BrandGlow}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavAuxItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Margin="12,1" Padding="10,5" CornerRadius="9" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateHover}" />
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateSelected}" />
                                <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 最大化时由代码behind加 7px 内边距,抵消 WindowChrome 越界。 -->
    <Grid x:Name="Root" Background="{DynamicResource Color.Background}"
          TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 顶栏 ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Color.Background}" BorderBrush="{DynamicResource Color.Divider}" BorderThickness="0,0,0,1">
            <Grid>
                <!-- 品牌:Logo(暂用枫原万叶)+ 名称 + 品牌文案 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True">
                        <Image Source="pack://application:,,,/Viora.UI;component/logo.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding AppTitle}" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Color.Text.Primary}" />
                    <Border Width="1" Height="16" Background="{DynamicResource Color.Divider}" Margin="14,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppTagline}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Color.Text.Secondary}" />
                </StackPanel>

                <!-- 右侧:头像 / 语言 / 窗口控制 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                            shellns:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TopBarPillButton}" ToolTip="{loc:Translate TopBar.Account}">
                        <controls:VioraIcon Geometry="{StaticResource Icon.CircleUser}" Width="19" Height="19" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>

                    <Button x:Name="LanguageButton" Style="{StaticResource TopBarPillButton}" Margin="4,0,0,0"
                            Click="OnLanguageClick"
                            ToolTip="{loc:Translate TopBar.Language}">
                        <StackPanel Orientation="Horizontal">
                            <controls:VioraIcon Geometry="{StaticResource Icon.Globe}" Width="15" Height="15"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{Binding CurrentLanguageName}" Margin="7,0,0,0" VerticalAlignment="Center" />
                            <controls:VioraIcon Geometry="{StaticResource Icon.ChevronDown}" Width="9" Height="9" Margin="7,1,0,0"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <!-- ContextMenu 不在可视树内,无法用 ElementName;打开时会自动以按钮为 PlacementTarget -->
                            <ContextMenu Style="{StaticResource DarkContextMenu}"
                                         ItemsSource="{Binding Languages}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource DarkMenuItem}">
                                        <Setter Property="IsCheckable" Value="True" />
                                        <Setter Property="IsChecked" Value="{Binding DataContext.CurrentLanguageName, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource LangNameEquals}, Mode=OneWay}" />
                                        <Setter Property="Command" Value="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="Header" Value="{Binding Converter={StaticResource LangNameOf}}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource Color.Divider}" Margin="10,0" />

                    <Button Style="{StaticResource CaptionButton}" Command="{Binding MinimizeCommand}" ToolTip="{loc:Translate Window.Minimize}">
                        <controls:VioraIcon Geometry="{StaticResource Icon.Minus}" Width="13" Height="13"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Command="{Binding MaximizeOrRestoreCommand}" ToolTip="{loc:Translate Window.Maximize}">
                        <Grid>
                            <controls:VioraIcon Style="{StaticResource VioraIconOutline}" Geometry="{StaticResource Icon.Square}" Width="12" Height="12"
                                                StrokeThickness="56"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Visibility="{Binding IsMaximized, Converter={StaticResource InverseBoolToVisibility}}" />
                            <controls:VioraIcon Geometry="{StaticResource Icon.Compress}" Width="12" Height="12"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                Visibility="{Binding IsMaximized, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Command="{Binding CloseAppCommand}" ToolTip="{loc:Translate Window.Close}">
                        <controls:VioraIcon Geometry="{StaticResource Icon.Xmark}" Width="12" Height="12"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 主体(界面缩放挂载于此,顶栏/窗口边框不缩放) ================= -->
        <Grid Grid.Row="1" LayoutTransform="{Binding UiScaleTransform}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左侧导航 ============ -->
            <Border Grid.Column="0" Background="{DynamicResource Color.Background}" BorderBrush="{DynamicResource Color.Divider}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 核心功能 -->
                    <ListBox Grid.Row="0" BorderThickness="0" Background="Transparent" Padding="0,10,0,0"
                             ItemsSource="{Binding CoreItems}" SelectedItem="{Binding SelectedItem}"
                             ItemContainerStyle="{StaticResource NavCoreItem}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="IconTile" Width="38" Height="38" CornerRadius="11"
                                            Background="{DynamicResource Brush.Glass}" BorderBrush="{DynamicResource Color.Border}"
                                            BorderThickness="1">
                                        <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                            Width="19" Height="19"
                                                            Foreground="{DynamicResource Color.Text.Secondary}" />
                                    </Border>
                                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Color.Text.Primary}" />
                                        <TextBlock x:Name="Subtitle" Text="{Binding Subtitle}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Color.Text.Secondary}" />
                                    </StackPanel>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="IconTile" Property="Background" Value="#2EFFFFFF" />
                                        <Setter TargetName="IconTile" Property="BorderBrush" Value="#40FFFFFF" />
                                        <Setter TargetName="Title" Property="Foreground" Value="White" />
                                        <Setter TargetName="Subtitle" Property="Foreground" Value="#CCFFFFFF" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 品牌装饰 + 辅助导航 -->
                    <Grid Grid.Row="2" Margin="20,0,20,14">
                        <StackPanel>
                            <Image Source="pack://application:,,,/Viora.UI;component/logo.png" Width="72" Height="72"
                                   Stretch="Uniform" Opacity="0.92" HorizontalAlignment="Left" Margin="2,0,0,10" />
                            <TextBlock Text="{Binding AppTitle}" FontSize="19" FontStyle="Italic" FontWeight="SemiBold">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="{DynamicResource Color.PrimaryColor}" Offset="0" />
                                        <GradientStop Color="{DynamicResource Color.SecondaryColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <TextBlock Text="{loc:Translate Shell.Sidebar.Decoration}" FontSize="11" Margin="0,5,0,14"
                                       Foreground="{DynamicResource Color.Text.Secondary}" TextWrapping="Wrap" />

                            <ListBox BorderThickness="0" Background="Transparent"
                                     ItemsSource="{Binding AuxItems}" SelectedItem="{Binding SelectedItem}"
                                     ItemContainerStyle="{StaticResource NavAuxItem}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <controls:VioraIcon Geometry="{Binding IconKey, Converter={StaticResource IconKey}}"
                                                                Width="13" Height="13" Margin="2,0,0,0"
                                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock Text="{Binding Title}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 页面承载 ============ -->
            <ContentControl Grid.Column="1" x:Name="PageHost" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</UserControl>
