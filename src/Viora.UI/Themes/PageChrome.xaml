<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Viora.UI.Converters"
    xmlns:behaviors="clr-namespace:Viora.UI.Behaviors"
    xmlns:pages="clr-namespace:Viora.UI.Pages">

    <!--
        PageChrome (responsive): gutters shrink with window width so content stays
        comfortable from ~500px to ultrawide. The converter instance lives in THIS
        dictionary (declared before use) — a cross-dictionary StaticResource inside
        the template triggers a deferred-load recursion (stack overflow).
    -->
    <conv:ResponsiveGutterConverter x:Key="LocalGutter" />

    <Style TargetType="{x:Type pages:PageChrome}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type pages:PageChrome}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="Header" Margin="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LocalGutter}}" HorizontalAlignment="Center" MaxWidth="1200">
                            <TextBlock Style="{DynamicResource Typography.Title}" Text="{TemplateBinding pages:PageChrome.HeaderText}" />
                            <TextBlock x:Name="Subtitle" Style="{DynamicResource Typography.BodySecondary}" Margin="0,4,0,0"
                                       Text="{TemplateBinding pages:PageChrome.SubheaderText}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      behaviors:WheelBehavior.Enabled="True"
                                      Margin="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource LocalGutter}}">
                            <ContentPresenter x:Name="PageContent" HorizontalAlignment="Center" Content="{TemplateBinding pages:PageChrome.Content}" />
                        </ScrollViewer>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding SubheaderText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
