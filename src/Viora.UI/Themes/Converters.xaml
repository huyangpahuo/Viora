<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:Viora.UI.Converters">

    <!-- Shared converter instances used across pages/templates. -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:InverseBoolConverter x:Key="InverseBool" />
    <conv:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
    <conv:ResponsiveGutterConverter x:Key="ResponsiveGutter" />
    <conv:SidebarWidthConverter x:Key="SidebarWidth" />
    <conv:TranslateKeyConverter x:Key="TranslateKey" />
    <conv:IconKeyConverter x:Key="IconKey" />
    <conv:LanguageDisplayNameConverter x:Key="LangNameOf" />
    <conv:LanguageEqualsCurrentConverter x:Key="LangNameEquals" />
    <conv:EqualityConverter x:Key="Equals" />
</ResourceDictionary>
