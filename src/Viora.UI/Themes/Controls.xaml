<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Viora.UI.Controls"
    xmlns:conv="clr-namespace:Viora.UI.Converters">

    <!-- Local instances: deferred templates resolve StaticResource only within this file. -->
    <DropShadowEffect x:Key="LocalFlyoutShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.5" Color="#FF000000" />
    <conv:BoolToVisibilityConverter x:Key="LocalBoolToVisibility" />

    <!--
        Viora Fluent control styles (Material 3 language):
        pill filled buttons, state layers, outlined inputs, MD3 slider/switch,
        16-radius cards with hover lift. All colors via DynamicResource so the
        theme swap is live. Legacy style keys kept so v1 pages keep resolving.
    -->

    <!-- ============ VioraIcon (geometry library glyph) ============ -->
    <!-- Fill mode: the glyph renders solid in Foreground. StrokeThickness scales with
         the geometry, so outline thickness is expressed in viewBox units (640 full size). -->
    <Style TargetType="{x:Type controls:VioraIcon}">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VioraIcon}">
                    <Path Data="{TemplateBinding Geometry}" Fill="{TemplateBinding Foreground}" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline mode: stroke the geometry instead of filling (window-chrome glyphs such
         as the maximize square that must read as an outline, not a solid block). -->
    <Style x:Key="VioraIconOutline" TargetType="{x:Type controls:VioraIcon}" BasedOn="{StaticResource {x:Type controls:VioraIcon}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:VioraIcon}">
                    <Path Data="{TemplateBinding Geometry}"
                          Stroke="{TemplateBinding Foreground}"
                          StrokeThickness="{TemplateBinding StrokeThickness}"
                          Fill="{x:Null}" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ 深色细滚动条 ============ -->
    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBg" Background="#33FFFFFF" CornerRadius="4" Margin="1" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background" Value="#59FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="MinHeight" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Focusable="False">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="ThumbBg" Background="#33FFFFFF" CornerRadius="4" Margin="1" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBg" Property="Background" Value="#59FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ 深色右键/下拉菜单(语言切换、卡片更多菜单共用) ============ -->
    <Style x:Key="DarkContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Color.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            Effect="{DynamicResource Shadow.Flyout}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" />
                            <!-- ContextMenu 是独立视觉树,必须 DynamicResource 才能命中应用级图标库 -->
                            <controls:VioraIcon Grid.Column="1" Geometry="{DynamicResource Icon.Check}" Width="12" Height="12"
                                                Foreground="{DynamicResource Color.Primary}"
                                                Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource LocalBoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateSelected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Chip 胶囊单选列表项(风格分类 / 作品筛选共用) ============ -->
    <!-- 极简容器:自带模板替换默认样式,消除默认样式里指向 ItemsControl 祖先的对齐绑定
         (容器未挂树时该绑定会报"找不到源")。选中视觉由各列表的 DataTemplate 触发器负责。 -->
    <Style x:Key="PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChipPillItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Pill" Background="{DynamicResource Brush.Glass}" CornerRadius="15" Padding="13,5">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 分页页码按钮(Pager 控件) ============ -->
    <Style x:Key="PagerPageButton" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="9">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Filled (primary) button ============ -->
    <Style x:Key="VioraButton" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Color.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="22,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Capsule}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.SurfaceHigh}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MD3 filled icon button (circular) ============ -->
    <!-- Primary save-style actions: icon only, tooltip carries the label. -->
    <Style x:Key="SaveIconButton" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource Color.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse x:Name="Bg" Fill="{TemplateBinding Background}" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource Color.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource Color.AccentPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Segmented pill (RadioButton) ============ -->
    <!-- For pill switchers bound to one enum (e.g. compare mode). -->
    <Style x:Key="ModePill" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="Transparent" CornerRadius="12" Padding="12,4">
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.StateHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Tonal / secondary button ============ -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource VioraButton}">
        <Setter Property="Background" Value="{DynamicResource Color.SecondaryContainer}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Capsule}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.SurfaceHigh}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Danger button ============ -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource VioraButton}">
        <Setter Property="Background" Value="{DynamicResource Color.Danger}" />
        <Setter Property="Foreground" Value="#FF3A0004" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource Radius.Capsule}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.SurfaceHigh}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ IconButton (ghost, circular state layer) ============ -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{DynamicResource Radius.Capsule}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StatePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Link / text button ============ -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Primary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock
                        x:Name="Text"
                        Text="{TemplateBinding Content}"
                        Foreground="{TemplateBinding Foreground}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimaryContainer}" />
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MD3 switch ============ -->
    <Style x:Key="VioraToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="Track"
                            Background="{DynamicResource Color.SurfaceHigh}"
                            BorderBrush="{DynamicResource Color.Outline}"
                            BorderThickness="2"
                            CornerRadius="{DynamicResource Radius.ToggleTrack}" />
                        <Ellipse
                            x:Name="Thumb"
                            Width="16" Height="16"
                            Fill="{DynamicResource Color.Text.Secondary}"
                            HorizontalAlignment="Left"
                            Margin="4,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Color.Primary}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Color.OnPrimary}" />
                            <Setter TargetName="Thumb" Property="Width" Value="20" />
                            <Setter TargetName="Thumb" Property="Height" Value="20" />
                            <Setter TargetName="Thumb" Property="Margin" Value="20,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MD3 slider: active track fill computed live via MultiBinding ============ -->
    <Style x:Key="VioraSlider" TargetType="Slider">
        <Setter Property="Height" Value="26" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border x:Name="TrackBorder" Height="6" Background="{DynamicResource Color.SurfaceHigh}"
                                CornerRadius="3" VerticalAlignment="Center" />
                        <Border Height="6" CornerRadius="3" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Background="{DynamicResource Color.Primary}">
                            <Border.Width>
                                <MultiBinding Converter="{x:Static conv:Converters.SliderFill}">
                                    <Binding Path="Value" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Minimum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="Maximum" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" ElementName="TrackBorder" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" FocusVisualStyle="{x:Null}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Ellipse x:Name="Halo" Fill="{DynamicResource Color.Primary}" Opacity="0" Margin="-6" />
                                                <Ellipse Fill="{DynamicResource Color.OnPrimary}" Margin="3" />
                                                <Ellipse Fill="{DynamicResource Color.Primary}" Margin="6" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.22" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Halo" Property="Opacity" Value="0.35" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Outlined ComboBox ============ -->
    <Style x:Key="VioraCombo" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="Toggle"
                            Focusable="False"
                            ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="Root"
                                        Background="{DynamicResource Color.SurfaceElevated}"
                                        BorderBrush="{DynamicResource Color.Outline}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Medium}">
                                        <Path
                                            Data="M0,0 L4,4 8,0"
                                            Stroke="{DynamicResource Color.Text.Secondary}"
                                            StrokeThickness="1.5"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Color.Text.Primary}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            Margin="12,0,28,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                        <Popup
                            x:Name="PART_Popup"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            AllowsTransparency="True"
                            PopupAnimation="Fade">
                            <Border
                                Background="{DynamicResource Color.SurfaceElevated}"
                                BorderBrush="{DynamicResource Color.Outline}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Medium}"
                                Margin="0,4,8,8"
                                MinWidth="{TemplateBinding ActualWidth}"
                                MaxHeight="280">
                                <Border.Effect>
                                    <StaticResource ResourceKey="LocalFlyoutShadow" />
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border
                                    x:Name="Root"
                                    Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Color.StateSelected}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Outlined TextBox ============ -->
    <Style x:Key="VioraTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Color.SurfaceElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Color.Primary}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource Color.Outline}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Radius.Medium}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Color.Primary}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Card (MD3 elevated) ============ -->
    <Style x:Key="VioraCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Color.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Color.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Large}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Interactive card with hover elevation -->
    <Style x:Key="VioraCardHover" TargetType="Border" BasedOn="{StaticResource VioraCard}">
        <Setter Property="Effect" Value="{DynamicResource Shadow.Card}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Effect" Value="{DynamicResource Shadow.CardHover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Color.Outline}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============ FormCheckBox (settings row) ============ -->
    <Style TargetType="{x:Type controls:FormCheckBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FormCheckBox}">
                    <StackPanel Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{DynamicResource VioraToggle}"
                                          IsChecked="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="14" Foreground="{DynamicResource Color.Text.Primary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="12" Foreground="{DynamicResource Color.Text.Secondary}"
                                   Margin="58,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
