<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Material 3 navigation item: rounded-rectangle active indicator (height 44,
        radius 12). Works in rail and full sidebar.
    -->

    <Style x:Key="NavGroupHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Disabled}" />
        <Setter Property="Margin" Value="18,18,12,4" />
    </Style>

    <Style x:Key="NavListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Color.Text.Secondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Height="44" Margin="10,2">
                        <Border
                            x:Name="Pill"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Medium}" />
                        <ContentPresenter x:Name="Content" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.StateHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Color.PrimaryContainer}" />
                            <Setter Property="Foreground" Value="{DynamicResource Color.OnPrimaryContainer}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
