<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <!-- 只保留 en/zh-Hans 运行时资源:裁掉 cs/de/es 等十几个 .NET 系统语言文件夹(与界面语言无关) -->
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <AssemblyName>Viora</AssemblyName>
    <RootNamespace>Viora.App</RootNamespace>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <!-- exe 文件图标:Explorer、桌面快捷方式与任务栏(未显式设置窗口图标时的回退) -->
    <ApplicationIcon>../../assets/viora.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 供 MainWindow.Icon(pack URI)运行时使用 -->
    <Resource Include="../../assets/viora.ico" Link="viora.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Viora.Core\Viora.Core.csproj" />
    <ProjectReference Include="..\Viora.Infrastructure\Viora.Infrastructure.csproj" />
    <ProjectReference Include="..\Viora.Localization\Viora.Localization.csproj" />
    <ProjectReference Include="..\Viora.PluginSdk\Viora.PluginSdk.csproj" />
    <ProjectReference Include="..\Viora.UI\Viora.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="languages\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 插件工坊:sdk 参考程序集随构建/发布附带,内存编译用户源码时引用 -->
  <Target Name="CollectWorkshopSdkBuild" AfterTargets="Build">
    <ItemGroup>
      <WorkshopSdk Include="$(MSBuildThisFileDirectory)../../assets/sdk/*.dll" />
      <WorkshopSdk Include="$(OutDir)Viora.Core.dll" />
      <WorkshopSdk Include="$(OutDir)Viora.PluginSdk.dll" />
      <WorkshopSdk Include="$(OutDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <WorkshopSdk Include="$(OutDir)System.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkshopSdk)" DestinationFolder="$(OutDir)sdk" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CollectWorkshopSdkPublish" AfterTargets="Publish">
    <ItemGroup>
      <WorkshopSdk Include="$(MSBuildThisFileDirectory)../../assets/sdk/*.dll" />
      <WorkshopSdk Include="$(PublishDir)Viora.Core.dll" />
      <WorkshopSdk Include="$(PublishDir)Viora.PluginSdk.dll" />
      <WorkshopSdk Include="$(PublishDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <WorkshopSdk Include="$(PublishDir)System.*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkshopSdk)" DestinationFolder="$(PublishDir)sdk" SkipUnchangedFiles="true" />
  </Target>

</Project>
